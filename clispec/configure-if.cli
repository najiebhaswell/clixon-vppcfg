# SPDX-License-Identifier: Apache-2.0
# Interface configuration mode (prompt "BR(config-if)#").
CLICON_MODE="configure-if";
CLICON_PROMPT="%H(config-if)# ";
CLICON_PLUGIN="cli_vppcfg";

description("Interface description (also SNMP ifAlias)") <text:rest>("Text, max. 64 characters, no quotes"), vc_set_leaf("description", "text");
mtu("Packet MTU") <mtu:uint16 range[128:9216]>("128-9216"), vc_set_leaf("mtu", "mtu");
mac-address("MAC address") <mac:macaddr>("xx:xx:xx:xx:xx:xx"), vc_set_leaf("mac", "mac");
ip("IPv4") address("Add an IPv4 address") <addr:string regexp:"[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+/[0-9]+">("A.B.C.D/length"), vc_add_ll("address", "addr");
ipv6("IPv6") address("Add an IPv6 address") <addr:string regexp:"[0-9a-fA-F:.]+/[0-9]+">("X:X::X/length"), vc_add_ll("address", "addr");
lcp("Linux TAP name (linux-cp) in the dataplane netns") <name:string regexp:"[a-z][a-z0-9.-]{0,14}">("Max. 15 characters; sub-interface: <parent lcp>.<id>, e.g. cx5-0.100"), vc_set_leaf("lcp", "name");
unnumbered("Borrow the address of another interface") (<ifname:string vc_expand_ifs()>("Source interface")|<ifname:string>("Source interface")), vc_set_leaf("unnumbered", "ifname");
l2xc("L2 cross-connect to another interface") (<ifname:string vc_expand_ifs()>("Target interface")|<ifname:string>("Target interface")), vc_set_leaf("l2xc", "ifname");
mpls("MPLS") enable("Enable MPLS"), vc_set_leaf("mpls", "=true");
sflow("sFlow") enable("Enable sFlow sampling"), vc_set_leaf("sflow", "=true");
shutdown("Disable the interface (admin down)"), vc_set_leaf("state", "=down");
encapsulation("Sub-interface VLAN encapsulation") {
    dot1q("802.1Q (C-tag)") <outer:uint16 range[1:4095]>("VLAN ID") [inner-dot1q("Inner tag (QinQ)") <inner:uint16 range[1:4095]>("Inner VLAN ID")] [<exact:string keyword:exact-match>("Match the exact tag stack only")], vc_encap("dot1q");
    dot1ad("802.1ad (S-tag)") <outer:uint16 range[1:4095]>("VLAN ID") [inner-dot1q("Inner tag") <inner:uint16 range[1:4095]>("Inner VLAN ID")] [<exact:string keyword:exact-match>("Match the exact tag stack only")], vc_encap("dot1ad");
}
member("Add a bond member") <ifname:string vc_expand_ifs("phy")>("Physical member interface"), vc_add_ll("interface", "ifname", "bond");
mode("Bond mode") <bmode:string choice:lacp|xor|active-backup|round-robin|broadcast>("Mode"), vc_set_leaf("mode", "bmode", "bond");
load-balance("Bond load-balance hash") <lb:string choice:l2|l23|l34>("Hash"), vc_set_leaf("load-balance", "lb", "bond");

no("Negate a command") {
    description("Remove the description"), vc_del_leaf("description");
    mtu("Restore the default MTU"), vc_del_leaf("mtu");
    mac-address("Restore the default MAC address"), vc_del_leaf("mac");
    ip("IPv4") address("Remove an IPv4 address") <addr:string regexp:"[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+/[0-9]+">("A.B.C.D/length"), vc_del_ll("address", "addr");
    ipv6("IPv6") address("Remove an IPv6 address") <addr:string regexp:"[0-9a-fA-F:.]+/[0-9]+">("X:X::X/length"), vc_del_ll("address", "addr");
    lcp("Remove the linux-cp pair"), vc_del_leaf("lcp");
    unnumbered("Remove unnumbered"), vc_del_leaf("unnumbered");
    l2xc("Remove the L2 cross-connect"), vc_del_leaf("l2xc");
    mpls("Disable MPLS"), vc_del_leaf("mpls");
    sflow("Disable sFlow"), vc_del_leaf("sflow");
    shutdown("Enable the interface (admin up)"), vc_del_leaf("state");
    encapsulation("Remove the encapsulation (defaults to dot1q = sub-interface number)"), vc_del_leaf("encapsulation");
    member("Remove a bond member") <ifname:string vc_expand_ifs("phy")>("Physical member interface"), vc_del_ll("interface", "ifname", "bond");
    mode("Restore the default bond mode"), vc_del_leaf("mode", "bond");
    load-balance("Restore the default hash"), vc_del_leaf("load-balance", "bond");
}
exit("Return to configuration mode"), vc_if_exit();
