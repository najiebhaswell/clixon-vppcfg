# commit/validate/abort/end, available in global and interface configuration modes.
CLICON_MODE="configure:configure-if:configure-subif:configure-loop:configure-bond:configure-router:configure-router-af:configure-rmap";
CLICON_PLUGIN="cli_vppcfg";

commit("Validate and apply the candidate to VPP; the result is saved and survives reboots"), vc_commit(); {
    <confirmed:string keyword:confirmed>("Apply provisionally; roll back automatically unless confirmed with 'commit'") <minutes:uint32 range[1:120]>("Minutes until automatic rollback (1-120)"), vc_commit();
    cancel("Roll back the pending confirmed commit now"), vc_commit_cancel();
}
validate("Check the candidate with vppcfg (syntax and against the running VPP) without applying it"), vc_validate();
abort("Discard all uncommitted changes and return to exec mode"), vc_abort("exec");
end("Return to exec mode (refused while there are uncommitted changes)"), vc_end();
