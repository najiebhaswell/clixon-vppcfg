# Loopback mode (prompt "BR(config-if)#").
CLICON_MODE="configure-loop";
CLICON_PROMPT="%H(config-if)# ";
CLICON_PLUGIN="cli_vppcfg";

mac-address("Set the loopback MAC address (default: generated by VPP)") <mac:macaddr>("xx:xx:xx:xx:xx:xx"), vc_set_leaf("mac", "mac");
no("Negate a command") mac-address("Revert to the VPP-generated MAC address"), vc_del_leaf("mac");
