# SPDX-License-Identifier: Apache-2.0
# BGP, prefix-lists, community-lists and route-maps (Cisco style), rendered to BIRD.
CLICON_MODE="configure";
CLICON_PLUGIN="cli_vppcfg";

router("Routing protocol") bgp("BGP routing (BIRD)") (<asn:string vc_expand_names("/bgp:routing/bgp:bgp", "local-as", "Configured local AS")>("Local AS number")|<asn:uint32 range[1:4294967295]>("Local AS number")), vc_enter("configure-router", "<routing><bgp><local-as>$asn</local-as></bgp></routing>");
router-id("Router ID used by BIRD (also the BGP identifier)") <rid:ipv4addr>("A.B.C.D"), vc_edit("<routing><router-id>$rid</router-id></routing>");
ip("IPv4") {
    prefix-list("IPv4 prefix list (first match wins, implicit deny at the end)") <name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("Prefix list name") seq("Sequence number") <seq:uint32 range[1:4294967295]>("Sequence number; lower is evaluated first") (<action:string keyword:permit>("Permit matching routes")|<action:string keyword:deny>("Deny matching routes")) <prefix:string regexp:"[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+/[0-9]+">("Prefix A.B.C.D/len") [ge("Minimum prefix length") <ge:uint8 range[1:32]>("Minimum length")] [le("Maximum prefix length") <le:uint8 range[1:32]>("Maximum length")], vc_edit("<routing><prefix-list><name>$name</name><entry nc:operation='replace'><seq>$seq</seq><action>$action</action><prefix>$prefix</prefix>[<ge>$ge</ge>][<le>$le</le>]</entry></prefix-list></routing>");
    community-list("Standard community list") <name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("Community list name") permit("Add a community") <comm:string regexp:"[0-9]{1,5}:[0-9]{1,5}">("Community ASN:value, e.g. 65000:100"), vc_edit("<routing><community-list><name>$name</name><community>$comm</community></community-list></routing>");
}
ipv6("IPv6") prefix-list("IPv6 prefix list (first match wins, implicit deny at the end)") <name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("Prefix list name") seq("Sequence number") <seq:uint32 range[1:4294967295]>("Sequence number; lower is evaluated first") (<action:string keyword:permit>("Permit matching routes")|<action:string keyword:deny>("Deny matching routes")) <prefix:string regexp:"[0-9a-fA-F:.]+/[0-9]+">("Prefix X:X::X/len") [ge("Minimum prefix length") <ge:uint8 range[1:128]>("Minimum length")] [le("Maximum prefix length") <le:uint8 range[1:128]>("Maximum length")], vc_edit("<routing><prefix-list><name>$name</name><entry nc:operation='replace'><seq>$seq</seq><action>$action</action><prefix>$prefix</prefix>[<ge>$ge</ge>][<le>$le</le>]</entry></prefix-list></routing>");
route-map("Route map: policy for routes received from or announced to BGP peers") <name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("Route map name") (<action:string keyword:permit>("Permit matching routes")|<action:string keyword:deny>("Deny matching routes")) <seq:uint32 range[1:4294967295]>("Sequence number; lower is evaluated first"), vc_enter("configure-rmap", "<routing><route-policy><name>$name</name><node><seq>$seq</seq><action>$action</action></node></route-policy></routing>", "rp=$name", "rseq=$seq");
no("Negate a command") {
    router("Routing protocol") bgp("Remove the whole BGP configuration (all neighbors, networks)") [(<asn:string vc_expand_names("/bgp:routing/bgp:bgp", "local-as", "Configured local AS")>("Local AS number")|<asn:uint32 range[1:4294967295]>("Local AS number"))], vc_edit("<routing><bgp nc:operation='remove'/></routing>");
    router-id("Remove the router ID (BIRD then picks one from the interfaces)"), vc_edit("<routing><router-id nc:operation='remove'/></routing>");
    ip("IPv4") {
        prefix-list("Remove a prefix list or one entry") (<pl:string vc_expand_names("/bgp:routing/bgp:prefix-list", "name", "Prefix list")>("Prefix list")|<pl:string>("Prefix list name")), vc_edit("<routing><prefix-list nc:operation='remove'><name>$pl</name></prefix-list></routing>"); {
            seq("Remove one entry") <seq:uint32 range[1:4294967295]>("Sequence number"), vc_edit("<routing><prefix-list><name>$pl</name><entry nc:operation='remove'><seq>$seq</seq></entry></prefix-list></routing>");
        }
        community-list("Remove a community list or one community") (<cl:string vc_expand_names("/bgp:routing/bgp:community-list", "name", "Community list")>("Community list")|<cl:string>("Community list name")), vc_edit("<routing><community-list nc:operation='remove'><name>$cl</name></community-list></routing>"); {
            permit("Remove one community") <comm:string regexp:"[0-9]{1,5}:[0-9]{1,5}">("Community ASN:value, e.g. 65000:100"), vc_edit("<routing><community-list><name>$cl</name><community nc:operation='remove'>$comm</community></community-list></routing>");
        }
    }
    ipv6("IPv6") prefix-list("Remove a prefix list or one entry") (<pl:string vc_expand_names("/bgp:routing/bgp:prefix-list", "name", "Prefix list")>("Prefix list")|<pl:string>("Prefix list name")), vc_edit("<routing><prefix-list nc:operation='remove'><name>$pl</name></prefix-list></routing>"); {
        seq("Remove one entry") <seq:uint32 range[1:4294967295]>("Sequence number"), vc_edit("<routing><prefix-list><name>$pl</name><entry nc:operation='remove'><seq>$seq</seq></entry></prefix-list></routing>");
    }
    route-map("Remove a route map or one sequence") (<rm:string vc_expand_names("/bgp:routing/bgp:route-policy", "name", "Route map")>("Route map")|<rm:string>("Route map name")), vc_edit("<routing><route-policy nc:operation='remove'><name>$rm</name></route-policy></routing>"); {
        (<action:string keyword:permit>("Permit matching routes")|<action:string keyword:deny>("Deny matching routes")) <seq:uint32 range[1:4294967295]>("Sequence number"), vc_edit("<routing><route-policy><name>$rm</name><node nc:operation='remove'><seq>$seq</seq></node></route-policy></routing>");
    }
}
