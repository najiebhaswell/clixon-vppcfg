# SPDX-License-Identifier: Apache-2.0
# route-map mode (prompt "BR(config-route-map)#"); context $rp = name, $rseq = sequence.
CLICON_MODE="configure-rmap";
CLICON_PROMPT="%H(config-route-map)# ";
CLICON_PLUGIN="cli_vppcfg";

match("Conditions; all must be true for this sequence to apply") {
    ip("IPv4") address("Destination prefix") prefix-list("Match a prefix list") (<pl:string vc_expand_names("/bgp:routing/bgp:prefix-list", "name", "Prefix list")>("Prefix list")|<pl:string>("Prefix list name")), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><match><prefix-list>$pl</prefix-list></match></node></route-policy></routing>");
    ipv6("IPv6") address("Destination prefix") prefix-list("Match a prefix list") (<pl:string vc_expand_names("/bgp:routing/bgp:prefix-list", "name", "Prefix list")>("Prefix list")|<pl:string>("Prefix list name")), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><match><prefix-list>$pl</prefix-list></match></node></route-policy></routing>");
    community("Route carries any community of a community list") (<cl:string vc_expand_names("/bgp:routing/bgp:community-list", "name", "Community list")>("Community list")|<cl:string>("Community list name")), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><match><community-list>$cl</community-list></match></node></route-policy></routing>");
    as-path("AS path") {
        contains("AS path contains this AS") <asn:uint32 range[1:4294967295]>("AS number"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><match><as-path-contains>$asn</as-path-contains></match></node></route-policy></routing>");
        origin("Route originated by this AS (last AS in the path)") <asn:uint32 range[1:4294967295]>("AS number"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><match><origin-as>$asn</origin-as></match></node></route-policy></routing>");
    }
}
set("Actions applied when this sequence permits a route") {
    local-preference("BGP local preference (higher is preferred, default 100)") <lp:uint32>("Local preference"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><set><local-preference>$lp</local-preference></set></node></route-policy></routing>");
    metric("MED announced to the neighbor (lower is preferred)") <med:uint32>("MED"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><set><med>$med</med></set></node></route-policy></routing>");
    community("Add a community; repeat for more") <comm:string regexp:"[0-9]{1,5}:[0-9]{1,5}">("Community ASN:value, e.g. 65000:100") [additive("Keep existing communities (always the case)")], vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><set><community>$comm</community></set></node></route-policy></routing>");
    as-path("AS path") prepend("Prepend an AS to the path") <asn:uint32 range[1:4294967295]>("AS number, usually the local AS"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><set><prepend-as>$asn</prepend-as><prepend-count nc:operation='remove'/></set></node></route-policy></routing>"); {
        repeat("Prepend several times") <count:uint8 range[1:10]>("Number of times, 1-10"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><set><prepend-as>$asn</prepend-as><prepend-count>$count</prepend-count></set></node></route-policy></routing>");
    }
}
no("Negate a command") {
    match("Remove a condition") {
        ip("IPv4") address("Destination prefix") prefix-list("Remove the prefix list condition"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><match><prefix-list nc:operation='remove'/></match></node></route-policy></routing>");
        ipv6("IPv6") address("Destination prefix") prefix-list("Remove the prefix list condition"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><match><prefix-list nc:operation='remove'/></match></node></route-policy></routing>");
        community("Remove the community condition"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><match><community-list nc:operation='remove'/></match></node></route-policy></routing>");
        as-path("AS path") {
            contains("Remove the AS-path condition"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><match><as-path-contains nc:operation='remove'/></match></node></route-policy></routing>");
            origin("Remove the origin-AS condition"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><match><origin-as nc:operation='remove'/></match></node></route-policy></routing>");
        }
    }
    set("Remove an action") {
        local-preference("Remove the local preference action"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><set><local-preference nc:operation='remove'/></set></node></route-policy></routing>");
        metric("Remove the MED action"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><set><med nc:operation='remove'/></set></node></route-policy></routing>");
        community("Remove a community") <comm:string regexp:"[0-9]{1,5}:[0-9]{1,5}">("Community ASN:value, e.g. 65000:100"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><set><community nc:operation='remove'>$comm</community></set></node></route-policy></routing>");
        as-path("AS path") prepend("Remove the prepend action"), vc_edit("<routing><route-policy><name>$rp</name><node><seq>$rseq</seq><set><prepend-as nc:operation='remove'/><prepend-count nc:operation='remove'/></set></node></route-policy></routing>");
    }
}
exit("Return to global configuration mode"), vc_if_exit("configure");
