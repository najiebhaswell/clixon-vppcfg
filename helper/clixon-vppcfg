def cisco_lines(cfg):
    out = []

    def l3(body, indent=" "):
        if "description" in body:
            out.append(f"{indent}description {body['description']}")
        if "mac" in body:
            out.append(f"{indent}mac-address {body['mac']}")
        if "mtu" in body:
            out.append(f"{indent}mtu {body['mtu']}")
        for a in body.get("addresses", []):
            out.append(f"{indent}{'ipv6' if ':' in a else 'ip'} address {a}")
        if "unnumbered" in body:
            out.append(f"{indent}unnumbered {body['unnumbered']}")
        if "lcp" in body:
            out.append(f"{indent}lcp {body['lcp']}")
        if "l2xc" in body:
            out.append(f"{indent}l2xc {body['l2xc']}")
        if body.get("mpls"):
            out.append(f"{indent}mpls enable")
        if body.get("sflow"):
            out.append(f"{indent}sflow enable")
        if body.get("state") == "down":
            out.append(f"{indent}shutdown")

    bonds = cfg.get("bondethernets", {})
    ifs = cfg.get("interfaces", {})
    for name in sorted(set(bonds) | set(ifs), key=natural_key):
        out.append(f"interface {name}")
        b = bonds.get(name)
        if b is not None:
            if "description" in b and "description" not in ifs.get(name, {}):
                out.append(f" description {b['description']}")
            if "mode" in b:
                out.append(f" mode {b['mode']}")
            if "load-balance" in b:
                out.append(f" load-balance {b['load-balance']}")
            for m in b.get("interfaces", []):
                out.append(f" member {m}")
        body = ifs.get(name, {})
        l3(body)
        out.append("!")
        for sid, sub in body.get("sub-interfaces", {}).items():
            out.append(f"interface {name}.{sid}")
            e = sub.get("encapsulation", {})
            if e:
                if "dot1ad" in e:
                    s = f" encapsulation dot1ad {e['dot1ad']}"
                    if "inner-dot1q" in e:
                        s += f" inner-dot1q {e['inner-dot1q']}"
                else:
                    s = f" encapsulation dot1q {e.get('dot1q', '')}"
                    if "inner-dot1q" in e:
                        s += f" inner-dot1q {e['inner-dot1q']}"
                if e.get("exact-match"):
                    s += " exact-match"
                out.append(s)
            l3(sub)
            out.append("!")
    for name, body in cfg.get("loopbacks", {}).items():
        out.append(f"interface {name}")
        l3(body)
        out.append("!")
    return out


def vrp_name(name):
    """VPP name -> Huawei VRP alias: BondEthernetN -> Eth-TrunkN, loopN -> LoopBackN."""
    m = re.match(r"^BondEthernet(\d+)(\..*)?$", name)
    if m:
        return f"Eth-Trunk{m.group(1)}{m.group(2) or ''}"
    m = re.match(r"^loop(\d+)$", name)
    return f"LoopBack{m.group(1)}" if m else name


VRP_MODE = {"lacp": "lacp-static", "xor": "manual load-balance", "active-backup": "active-backup",
            "round-robin": "round-robin", "broadcast": "broadcast"}
VRP_LB = {"l2": "src-dst-mac", "l23": "src-dst-ip", "l34": "src-dst-ip-port"}


def vrp_lines(cfg, only=None):
    """Render the configuration Huawei VRP style; only = VPP name of one interface."""
    out = []
    bonds = cfg.get("bondethernets", {})
    ifs = cfg.get("interfaces", {})
    member_of = {m: name for name, b in bonds.items() for m in b.get("interfaces", [])}

    def l3(body, indent=" "):
        if "mac" in body:
            out.append(f"{indent}mac-address {body['mac']}")
        if "mtu" in body:
            out.append(f"{indent}mtu {body['mtu']}")
        v4 = [a for a in body.get("addresses", []) if ":" not in a]
        v6 = [a for a in body.get("addresses", []) if ":" in a]
        for i, a in enumerate(v4):
            ip, plen = a.split("/")
            mask = ipaddress.IPv4Network(f"0.0.0.0/{plen}").netmask
            out.append(f"{indent}ip address {ip} {mask}" + (" sub" if i else ""))
        if "unnumbered" in body:
            out.append(f"{indent}ip address unnumbered interface {vrp_name(body['unnumbered'])}")
        if v6:
            out.append(f"{indent}ipv6 enable")
            for a in v6:
                out.append(f"{indent}ipv6 address {a}")
        if "lcp" in body:
            out.append(f"{indent}lcp {body['lcp']}")
        if "l2xc" in body:
            out.append(f"{indent}l2xc {vrp_name(body['l2xc'])}")
        if body.get("mpls"):
            out.append(f"{indent}mpls")
        if body.get("sflow"):
            out.append(f"{indent}sflow enable")
        if body.get("state") == "down":
            out.append(f"{indent}shutdown")

    for name in sorted(set(bonds) | set(ifs), key=natural_key):
        body = ifs.get(name, {})
        if only in (None, name):
            out += ["#", f"interface {vrp_name(name)}"]
            b = bonds.get(name)
            desc = body.get("description") or (b or {}).get("description")
            if desc:
                out.append(f" description {desc}")
            if b is not None:
                if "mode" in b:
                    out.append(f" mode {VRP_MODE[b['mode']]}")
                if "load-balance" in b:
                    out.append(f" load-balance {VRP_LB[b['load-balance']]}")
            if name in member_of:
                out.append(f" eth-trunk {member_of[name][len('BondEthernet'):]}")
            l3({k: v for k, v in body.items() if k != "description"})
        for sid, sub in body.get("sub-interfaces", {}).items():
            sname = f"{name}.{sid}"
            if only not in (None, sname):
                continue
            out += ["#", f"interface {vrp_name(sname)}"]
            if "description" in sub:
                out.append(f" description {sub['description']}")
            e = sub.get("encapsulation", {})
            outer = e.get("dot1q", e.get("dot1ad"))
            if e and "inner-dot1q" in e:
                out.append(f" qinq termination pe-vid {outer} ce-vid {e['inner-dot1q']}"
                           + (" dot1ad" if "dot1ad" in e else ""))
            elif e:
                if e.get("exact-match"):
                    out.append(f" {'dot1ad' if 'dot1ad' in e else 'dot1q'} termination vid {outer}")
                else:
                    out.append(f" vlan-type {'dot1ad' if 'dot1ad' in e else 'dot1q'} {outer}")
            l3({k: v for k, v in sub.items() if k != "description"})
    for name, body in cfg.get("loopbacks", {}).items():
        if only not in (None, name):
            continue
        out += ["#", f"interface {vrp_name(name)}"]
        if "description" in body:
            out.append(f" description {body['description']}")
        l3({k: v for k, v in body.items() if k != "description"})
    if only is None:
        out += ["#", "return"]
    elif out:
        out += ["#", "return"]
    return out


def session_af(name):
    """Address family that shows a setting of the whole session: the one of the peer address."""
    return "ipv6" if ":" in name else "ipv4"


def peer_order(bgp):
    groups = sorted(bgp.get("peer-group", {}), key=natural_key)
    neighbors = sorted(bgp.get("neighbor", {}),
                       key=lambda a: (ipaddress.ip_address(a).version, ipaddress.ip_address(a)) if is_ip(a) else (9, a))
    return groups, neighbors


def prefix_list_family(pl):
    return "ipv6" if any(":" in e.get("prefix", "") for e in pl.get("entry", {}).values()) else "ip"


def cisco_bgp_lines(r):
    out = []
    bgp = r.get("bgp", {})
    for ver, cmd in ((4, "ip"), (6, "ipv6")):
        for net, dest, e in static_routes(r, ver):
            line = f"{cmd} route {net} {'Null0' if dest == 'blackhole' else dest}"
            out.append(line + (f" as-path {e['prepend']}" if "prepend" in e else ""))
    if out:
        out.append("!")
    if bgp or "router-id" in r or rpki_sessions(r):
        if "local-as" in bgp:
            out.append(f"router bgp {bgp['local-as']}")
            if "router-id" in r:
                out.append(f" bgp router-id {r['router-id']}")
        elif "router-id" in r:
            out.append(f"router-id {r['router-id']}")
        for addr in sorted(rpki_sessions(r), key=natural_key):
            s = rpki_sessions(r)[addr]
            line = f" bgp rpki server tcp {addr}"
            line += f" port {s['port']}" if "port" in s else ""
            line += "".join(f" {k} {s[k]}" for k in ("refresh", "retry", "aging") if k in s)
            line += f" source {s['source-address']}" if "source-address" in s else ""
            out.append(line)
        groups, neighbors = peer_order(bgp)

        def peer(name, p, group):
            if group:
                out.append(f" neighbor {name} peer-group")
            if "remote-as" in p:
                out.append(f" neighbor {name} remote-as {p['remote-as']}")
            if not group and "peer-group" in p:
                out.append(f" neighbor {name} peer-group {p['peer-group']}")
            if "name" in p:
                out.append(f" neighbor {name} name {p['name']}")
            if "description" in p:
                out.append(f" neighbor {name} description {p['description']}")
            if "source-address" in p:
                out.append(f" neighbor {name} update-source {p['source-address']}")
            if "password" in p:
                out.append(f" neighbor {name} password {p['password']}")
            if "multihop" in p:
                out.append(f" neighbor {name} ebgp-multihop {p['multihop']}")
            if p.get("bfd"):
                out.append(f" neighbor {name} fall-over bfd")
            if "keepalive" in p or "hold-time" in p:
                out.append(f" neighbor {name} timers {p.get('keepalive', 60)} {p.get('hold-time', 240)}")
            if p.get("shutdown"):
                out.append(f" neighbor {name} shutdown")

        for g in groups:
            peer(g, bgp["peer-group"][g], True)
        for n in neighbors:
            peer(n, bgp["neighbor"][n], False)
        for af, ver in (("ipv4", 4), ("ipv6", 6)):
            lines = [f"  network {p}" for p in sorted(bgp.get("network", {}), key=natural_key)
                     if ipaddress.ip_network(p, strict=False).version == ver]
            for name in groups + neighbors:
                p = bgp.get("peer-group", {}).get(name) or bgp.get("neighbor", {}).get(name, {})
                a = p.get(af, {})
                if "activate" in a:
                    lines.append(f"  {'' if a['activate'] else 'no '}neighbor {name} activate")
                for d, kw in (("import", "in"), ("export", "out")):
                    if f"{d}-policy" in a:
                        lines.append(f"  neighbor {name} route-map {a[f'{d}-policy']} {kw}")
                    if f"{d}-filter" in a:
                        lines.append(f"  neighbor {name} bird-filter {a[f'{d}-filter']} {kw}")
                if "max-prefix" in a:
                    lines.append(f"  neighbor {name} maximum-prefix {a['max-prefix']}")
                if a.get("next-hop-self"):
                    lines.append(f"  neighbor {name} next-hop-self")
                if "allow-local-as" in p and af == session_af(name):
                    lines.append(f"  neighbor {name} allowas-in {p['allow-local-as']}")
                if p.get("reflect-client") and af == session_af(name):
                    lines.append(f"  neighbor {name} route-reflector-client")
            if lines:
                out += [" !", f" address-family {af} unicast"] + lines + [" exit-address-family"]
        out.append("!")
    for name, pl in r.get("prefix-list", {}).items():
        for seq in sorted(pl.get("entry", {})):
            e = pl["entry"][seq]
            fam = "ipv6" if ":" in e.get("prefix", "") else "ip"
            line = f"{fam} prefix-list {name} seq {seq} {e.get('action', '?')} {e.get('prefix', '?')}"
            line += f" ge {e['ge']}" if "ge" in e else ""
            line += f" le {e['le']}" if "le" in e else ""
            out.append(line)
        out.append("!")
    for name, cl in r.get("community-list", {}).items():
        for c in cl.get("community", []):
            out.append(f"ip community-list {name} permit {c}")
        out.append("!")
    for name, cl in r.get("large-community-list", {}).items():
        for c in cl.get("large-community", []):
            out.append(f"ip large-community-list {name} permit {c}")
        out.append("!")
    for name, al in r.get("as-path-list", {}).items():
        for seq in sorted(al.get("entry", {})):
            e = al["entry"][seq]
            out.append(f"ip as-path access-list {name} seq {seq} {e.get('action', '?')} {aspath_cli(e)}")
        out.append("!")
    for name, rp in r.get("route-policy", {}).items():
        for seq in sorted(rp.get("node", {})):
            node = rp["node"][seq]
            m, st = node.get("match", {}), node.get("set", {})
            out.append(f"route-map {name} {node.get('action', '?')} {seq}")
            if "prefix-list" in m:
                out.append(f" match ip address prefix-list {m['prefix-list']}")
            if "community-list" in m:
                out.append(f" match community {m['community-list']}")
            if "large-community-list" in m:
                out.append(f" match large-community {m['large-community-list']}")
            if "as-path-list" in m:
                out.append(f" match as-path {m['as-path-list']}")
            if "as-path-contains" in m:
                out.append(f" match as-path contains {m['as-path-contains']}")
            if "origin-as" in m:
                out.append(f" match as-path origin {m['origin-as']}")
            if "rpki" in m:
                out.append(f" match rpki {m['rpki']}")
            if "local-preference" in st:
                out.append(f" set local-preference {st['local-preference']}")
            if "preference" in st:
                out.append(f" set preference {st['preference']}")
            if "med" in st:
                out.append(f" set metric {st['med']}")
            if st.get("community"):
                out.append(f" set community {' '.join(st['community'])} additive")
            if st.get("large-community"):
                out.append(f" set large-community {' '.join(st['large-community'])} additive")
            if "prepend" in st:
                out.append(f" set as-path prepend {st['prepend']}")
            out.append("!")
    return out


def vrp_bgp_lines(r, section=None):
    """Huawei VRP rendering; section = None (all), "bgp" or "route-policy:<name>"."""
    out = []
    bgp = r.get("bgp", {})
    if section is None:
        for ver, cmd in ((4, "ip"), (6, "ipv6")):
            routes = static_routes(r, ver)
            out += ["#"] if routes else []
            for net, dest, e in routes:
                line = f"{cmd} route-static {net.network_address} {net.prefixlen} {'NULL0' if dest == 'blackhole' else dest}"
                out.append(line + (f" as-path {e['prepend']}" if "prepend" in e else ""))
    if section in (None, "rpki") and rpki_sessions(r):
        out += ["#", "rpki"]
        for addr in sorted(rpki_sessions(r), key=natural_key):
            s = rpki_sessions(r)[addr]
            out.append(f" session {addr}")
            if "port" in s:
                out.append(f"  tcp port {s['port']}")
            out += [f"  timer {k} {s[k]}" for k in ("aging", "refresh", "retry") if k in s]
            if "source-address" in s:
                out.append(f"  connect-interface {s['source-address']}")
    if section in (None, "bgp") and (bgp or "router-id" in r):
        out.append("#")
        if "local-as" in bgp:
            out.append(f"bgp {bgp['local-as']}")
            if "router-id" in r:
                out.append(f" router-id {r['router-id']}")
        elif "router-id" in r:
            out.append(f"router id {r['router-id']}")
        groups, neighbors = peer_order(bgp)

        def peer(name, p, group):
            if group:
                kind = "internal" if p.get("remote-as") and p.get("remote-as") == bgp.get("local-as") else "external"
                out.append(f" group {name} {kind}")
            if "remote-as" in p:
                out.append(f" peer {name} as-number {p['remote-as']}")
            if not group and "peer-group" in p:
                out.append(f" peer {name} group {p['peer-group']}")
            if "name" in p:
                out.append(f" peer {name} name {p['name']}")
            if "description" in p:
                out.append(f" peer {name} description {p['description']}")
            if "source-address" in p:
                out.append(f" peer {name} connect-interface {p['source-address']}")
            if "password" in p:
                out.append(f" peer {name} password simple {p['password']}")
            if "multihop" in p:
                out.append(f" peer {name} ebgp-max-hop {p['multihop']}")
            if p.get("bfd"):
                out.append(f" peer {name} bfd enable")
            if "keepalive" in p or "hold-time" in p:
                out.append(f" peer {name} timer keepalive {p.get('keepalive', 60)} hold {p.get('hold-time', 180)}")
            if p.get("shutdown"):
                out.append(f" peer {name} ignore")

        for g in groups:
            peer(g, bgp["peer-group"][g], True)
        for n in neighbors:
            peer(n, bgp["neighbor"][n], False)
        for af, ver in (("ipv4", 4), ("ipv6", 6)):
            lines = []
            for p in sorted(bgp.get("network", {}), key=natural_key):
                net = ipaddress.ip_network(p, strict=False)
                if net.version == ver:
                    lines.append(f"  network {net.network_address} {net.prefixlen}")
            for name in groups + neighbors:
                p = bgp.get("peer-group", {}).get(name) or bgp.get("neighbor", {}).get(name, {})
                a = p.get(af, {})
                if "activate" in a:
                    lines.append(f"  {'' if a['activate'] else 'undo '}peer {name} enable")
                for d in ("import", "export"):
                    if f"{d}-policy" in a:
                        lines.append(f"  peer {name} route-policy {a[f'{d}-policy']} {d}")
                    if f"{d}-filter" in a:
                        lines.append(f"  peer {name} bird-filter {a[f'{d}-filter']} {d}")
                if "max-prefix" in a:
                    lines.append(f"  peer {name} route-limit {a['max-prefix']}")
                if a.get("next-hop-self"):
                    lines.append(f"  peer {name} next-hop-local")
                if "allow-local-as" in p and af == session_af(name):
                    lines.append(f"  peer {name} allow-as-loop {p['allow-local-as']}")
                if p.get("reflect-client") and af == session_af(name):
                    lines.append(f"  peer {name} reflect-client")
            if lines:
                out += [" #", f" {af}-family unicast"] + lines
    if section is None:
        for name, pl in r.get("prefix-list", {}).items():
            out.append("#")
            for seq in sorted(pl.get("entry", {})):
                e = pl["entry"][seq]
                net = ipaddress.ip_network(e.get("prefix", "0.0.0.0/0"), strict=False)
                kw = "ipv6-prefix" if net.version == 6 else "ip-prefix"
                line = f"ip {kw} {name} index {seq} {e.get('action', '?')} {net.network_address} {net.prefixlen}"
                line += f" greater-equal {e['ge']}" if "ge" in e else ""
                line += f" less-equal {e['le']}" if "le" in e else ""
                out.append(line)
        for name, cl in r.get("community-list", {}).items():
            out.append("#")
            out += [f"ip community-filter basic {name} permit {c}" for c in cl.get("community", [])]
        for name, cl in r.get("large-community-list", {}).items():
            out.append("#")
            out += [f"ip large-community-filter basic {name} permit {c}" for c in cl.get("large-community", [])]
        for name, al in r.get("as-path-list", {}).items():
            out.append("#")
            for seq in sorted(al.get("entry", {})):
                e = al["entry"][seq]
                out.append(f"ip as-path-filter {name} index {seq} {e.get('action', '?')} {aspath_cli(e)}")
    for name, rp in r.get("route-policy", {}).items():
        if section not in (None, f"route-policy:{name}"):
            continue
        for seq in sorted(rp.get("node", {})):
            node = rp["node"][seq]
            m, st = node.get("match", {}), node.get("set", {})
            out += ["#", f"route-policy {name} {node.get('action', '?')} node {seq}"]
            if "prefix-list" in m:
                out.append(f" if-match ip-prefix {m['prefix-list']}")
            if "community-list" in m:
                out.append(f" if-match community-filter {m['community-list']}")
            if "large-community-list" in m:
                out.append(f" if-match large-community-filter {m['large-community-list']}")
            if "as-path-list" in m:
                out.append(f" if-match as-path-filter {m['as-path-list']}")
            if "as-path-contains" in m:
                out.append(f" if-match as-path contains {m['as-path-contains']}")
            if "origin-as" in m:
                out.append(f" if-match as-path origin {m['origin-as']}")
            if "rpki" in m:
                out.append(f" if-match rpki origin-as-validation {m['rpki']}")
            if "local-preference" in st:
                out.append(f" apply local-preference {st['local-preference']}")
            if "preference" in st:
                out.append(f" apply preference {st['preference']}")
            if "med" in st:
                out.append(f" apply cost {st['med']}")
            for c in st.get("community", []):
                out.append(f" apply community {c} additive")
            for c in st.get("large-community", []):
                out.append(f" apply large-community {c} additive")
            if "prepend" in st:
                out.append(f" apply as-path {st['prepend']} additive")
    return out


def render_lines(cfg, style, only=None, bgp=None, system=None):
    bgp = bgp or {}
    host = (system or {}).get("hostname")
    if style == "vrp":
        if only in ("bgp", "rpki") or (only or "").startswith("route-policy:"):
            lines = vrp_bgp_lines(bgp, only)
            return lines + ["#", "return"] if lines else []
        lines = vrp_lines(cfg, only)
        if only is None:
            lines = lines[:-2] + vrp_bgp_lines(bgp) + ["#", "return"]
            if host:
                lines = ["#", f"sysname {host}"] + lines
        return lines
    if only == "bgp" or (only or "").startswith("route-policy:"):
        return cisco_bgp_lines(bgp)
    lines = cisco_lines(cfg)
    if only is None:
        return ([f"hostname {host}", "!"] if host else []) + lines + cisco_bgp_lines(bgp)
    # Cisco: keep the block of one interface
    out, keep = [], False
    for line in lines:
        if line.startswith("interface "):
            keep = line == f"interface {only}"
        if keep:
            out.append(line)
    return out


def cmd_show_config(xml_path, style="cisco", only=None):
    lines = render_lines(xml_to_cfg(xml_path), style, only, xml_to_bgp(xml_path), xml_to_system(xml_path))
    empty = "# (no configuration)" if style == "vrp" else "! (no configuration)"
    print("\n".join(lines) if lines else empty)


def prefix_entry(e):
    line = e.get("prefix", "?")
    line += f" ge {e['ge']}" if "ge" in e else ""
    line += f" le {e['le']}" if "le" in e else ""
    return line


def cmd_show_list(xml_path, kind, style="cisco", name=None):
    """show ip|ipv6 prefix-list, show ip as-path-access-list|community-list|large-community-list;
    display ip ip-prefix|ipv6-prefix|as-path-filter|community-filter|large-community-filter."""
    r = xml_to_bgp(xml_path)
    vrp = style == "vrp"
    if kind == "as-path":
        lists = {n: al.get("entry", {}) for n, al in r.get("as-path-list", {}).items()}
        what = "AS-path filter" if vrp else "AS-path access list"
        title, entry = ("As path filter {}" if vrp else "AS path access list {}"), aspath_cli
    elif kind in ("community", "large-community"):
        lists = {n: cl.get(kind, []) for n, cl in r.get(f"{kind}-list", {}).items()}
        what = kind.replace("-", " ") + (" filter" if vrp else " list")
        title = what.capitalize() + " {}"
    else:
        # A list can hold both families; each command shows the entries of its own, like the configuration
        lists = {n: {s: e for s, e in pl.get("entry", {}).items() if (":" in e.get("prefix", "")) == (kind == "ipv6")}
                 for n, pl in r.get("prefix-list", {}).items()}
        lists = {n: entries for n, entries in lists.items() if entries}
        what = ("IPv6" if kind == "ipv6" else "IP") + " prefix list"
        title, entry = ("Prefix-list {}" if vrp else f"{kind} prefix-list {{}}"), prefix_entry
    if name is not None and name not in lists:
        die(("Error: " if vrp else "% ") + f"{what[0].upper()}{what[1:]} {name} does not exist")
    if not lists:
        print(f"Info: No {what} is configured." if vrp else f"% No {what} configured.")
    out = []
    for n in [name] if name is not None else sorted(lists, key=natural_key):
        out.append(title.format(n))
        if kind in ("community", "large-community"):
            out += [f"        permit  {c}" if vrp else f"   permit {c}" for c in lists[n]]
        else:
            for seq in sorted(lists[n]):
                e = lists[n][seq]
                act = e.get("action", "?")
                out.append(f"        index: {seq:<10} {act:<7} {entry(e)}" if vrp else f"   seq {seq} {act} {entry(e)}")
        out.append("")
    if out:
        print("\n".join(out[:-1]))


def cmd_show_static(xml_path, ver, style="cisco"):
    routes = static_routes(xml_to_bgp(xml_path), ver)
    if not routes:
        print("Info: No static route is configured." if style == "vrp" else "% No static route configured.")
        return
    best = {}
    for line in birdc("show", "route", "protocol", f"cx_static{ver}").splitlines():
        m = re.match(r"(\S+/\d+)\s+\S+\s+\[[^\]]*\]\s*(\*?)", line)
        if m:
            best[ipaddress.ip_network(m.group(1))] = "Active" if m.group(2) else "Standby"
    null = "NULL0" if style == "vrp" else "Null0"
    print(f"{'Destination':<44} {'Next hop':<40} {'State':<9} AS path")
    for net, dest, e in routes:
        print(f"{str(net):<44} {null if dest == 'blackhole' else dest:<40} {best.get(net, 'Inactive'):<9} "
              f"{e.get('prepend', '')}".rstrip())


def birdc(*args):
    r = subprocess.run([BIRDC, *args], capture_output=True, text=True)
    return "\n".join(l for l in (r.stdout + r.stderr).splitlines() if not re.match(r"BIRD \S+ ready", l))


def no_rpki(style):
    print("Info: No RPKI session is configured." if style == "vrp" else "% No RPKI server configured.")


def bird_rpki_sessions(text):
    """RPKI protocols from 'birdc show protocols all': dicts with state, server, port, status, serial,
    updated and the imported ROAs per channel."""
    sessions, cur, chan = [], None, None
    for line in text.splitlines():
        m = re.match(r"\S+\s+RPKI\s+\S+\s+(\S+)", line)
        if m:
            cur = {"state": m.group(1), "roa4": "-", "roa6": "-"}
            sessions.append(cur)
            continue
        if cur is None:
            continue
        m = re.match(r"\s+Channel (roa[46])", line)
        if m:
            chan = m.group(1)
            continue
        m = re.match(r"\s+(Cache server|Cache port|Status|Serial number|Last update|Routes):\s+(.*)", line)
        if m and m.group(1) == "Routes":
            cur[chan] = m.group(2).split()[0]
        elif m:
            key = {"Cache server": "server", "Cache port": "port", "Status": "status",
                   "Serial number": "serial", "Last update": "updated"}[m.group(1)]
            cur[key] = m.group(2).replace("before ", "").strip()
    return sessions


def cmd_rpki_session(style, addr=None):
    if addr is not None:
        print(birdc("show", "protocols", "all", bird_ident("cx_rpki_", addr)))
        return
    sessions = bird_rpki_sessions(birdc("show", "protocols", "all", '"cx_rpki_*"'))
    if not sessions:
        no_rpki(style)
        return
    print(f"{'Server':<26} {'Port':<6} {'State':<6} {'Status':<30} {'Serial':<11} {'Updated':<12} {'ROA4':<8} ROA6")
    for s in sessions:
        print(f"{s.get('server', '?'):<26} {s.get('port', '?'):<6} {s['state']:<6} {s.get('status', '?'):<30} "
              f"{s.get('serial', '-'):<11} {s.get('updated', '-'):<12} {s['roa4']:<8} {s['roa6']}")


def rpki_net(prefix, style):
    try:
        return ipaddress.ip_network(prefix, strict=False)
    except ValueError:
        die(("Error: " if style == "vrp" else "% ") + f"{prefix} is not an IP address or prefix")


def cmd_rpki_table(arg, style):
    if arg == "statistics":
        counts = [re.search(r"(\d+) of \d+ routes", birdc("show", "route", "table", t, "count"))
                  for t in ("cx_roa4", "cx_roa6")]
        if None in counts:
            no_rpki(style)
        else:
            print(f"IPv4 ROAs: {counts[0].group(1)}\nIPv6 ROAs: {counts[1].group(1)}")
        return
    net = rpki_net(arg, style)
    table = f"cx_roa{net.version}"
    text = birdc(f"show route table {table} where net.len <= {net.prefixlen}"
                 f" && ({net.network_address}).mask(net.len) = net.ip")
    if "syntax error" in text or "No such table" in text:
        no_rpki(style)
        return
    # Several caches give the same ROA: show it once
    roas = sorted({re.match(r"(\S+)-(\d+) AS(\d+)", l).groups() for l in text.splitlines()
                   if re.match(r"\S+-\d+ AS\d+", l)}, key=lambda x: natural_key(x[0]))
    if not roas:
        print(f"No ROA covers {net}")
        return
    print(f"{'Network':<44} {'MaxLen':<7} Origin AS")
    for prefix, maxlen, asn in roas:
        print(f"{prefix:<44} {maxlen:<7} {asn}")


def cmd_rpki_validate(prefix, asn, style):
    net = rpki_net(prefix, style)
    table = f"cx_roa{net.version}"
    for state, roa, label in (("valid", "ROA_VALID", "Valid"), ("invalid", "ROA_INVALID", "Invalid")):
        text = birdc(f"eval roa_check({table}, {net}, {asn}) = {roa}")
        if "TRUE" not in text and "FALSE" not in text:
            no_rpki(style)
            return
        if "TRUE" in text:
            print(f"{net} origin AS {asn}: {label}")
            return
    print(f"{net} origin AS {asn}: NotFound")


def cmd_diff(a_path, b_path, style="cisco"):
    a = render_lines(xml_to_cfg(a_path), style, None, xml_to_bgp(a_path), xml_to_system(a_path))
    b = render_lines(xml_to_cfg(b_path), style, None, xml_to_bgp(b_path), xml_to_system(b_path))
    diff = list(difflib.unified_diff(a, b, "running", "candidate", lineterm="", n=2))
    none = "Info: No uncommitted configuration." if style == "vrp" else "% No uncommitted changes."
    print("\n".join(diff[2:]) if diff else none)


def cmd_changed(a_path, b_path):
    """Exit 1 if configurations a and b differ, 0 if identical."""
    same = (xml_to_cfg(a_path) == xml_to_cfg(b_path) and xml_to_bgp(a_path) == xml_to_bgp(b_path) and
            xml_to_system(a_path) == xml_to_system(b_path))
    sys.exit(0 if same else 1)


def vrp_rename_output(text):
    """Rewrite VPP names in vppctl output to VRP aliases, padding to keep columns aligned."""
    def sub(m):
        new = vrp_name(m.group(0))
        pad = len(m.group(0)) - len(new)
        follow = m.string[m.end():m.end() + 1]
        return new + (" " * pad if pad > 0 and follow == " " else "")
    return re.sub(r"\b(?:BondEthernet\d+(?:\.\d+)?|loop\d+)\b", sub, text)


def cmd_vppctl(args, style="cisco"):
    r = subprocess.run([VPPCTL, *args], capture_output=True, text=True)
    out = r.stdout + r.stderr
    sys.stdout.write(vrp_rename_output(out) if style == "vrp" else out)
    sys.exit(r.returncode)


def cmd_ip_brief(style="cisco"):
    r = subprocess.run([VPPCTL, "show", "interface", "address"], capture_output=True, text=True)
    if r.returncode != 0:
        die("vppctl failed: " + (r.stderr or r.stdout))
    rows, cur = [], None
    for line in r.stdout.splitlines():
        m = re.match(r"^(\S+) \((\w+)\):", line)
        if m:
            cur = [m.group(1), "up" if m.group(2) == "up" else "down", []]
            rows.append(cur)
        elif cur and line.strip().startswith("L3 "):
            cur[2].append(line.strip()[3:])
    rows = [x for x in rows if x[0] != "local0" and not x[0].startswith("tap")]
    rename = vrp_name if style == "vrp" else (lambda n: n)
    if style == "vrp":
        print(f"{'Interface':<24} {'IP Address/Mask':<34} Physical")
        for name, state, addrs in sorted(rows, key=lambda x: natural_key(x[0])):
            print(f"{rename(name):<24} {addrs[0] if addrs else 'unassigned':<34} {'up' if state == 'up' else '*down'}")
            for a in addrs[1:]:
                print(f"{'':<24} {a}")
        return
    print(f"{'Interface':<24} {'Admin':<6} Address")
    for name, state, addrs in sorted(rows, key=lambda x: natural_key(x[0])):
        print(f"{name:<24} {state:<6} {addrs[0] if addrs else 'unassigned'}")
        for a in addrs[1:]:
            print(f"{'':<24} {'':<6} {a}")


def pop_opt(args, name, default=None):
    """Remove "--name value" from args and return value."""
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            value = args[i + 1]
            del args[i:i + 2]
            return value
    return default


def main():
    if len(sys.argv) < 2:
        die(__doc__, 2)
    verb, args = sys.argv[1], sys.argv[2:]
    style = pop_opt(args, "--style", "cisco")
    only = pop_opt(args, "--if")
    if verb == "validate" and len(args) == 1:
        cmd_validate(args[0])
    elif verb == "apply" and len(args) == 1:
        cmd_apply(args[0])
    elif verb == "import" and len(args) == 1:
        cfg = yaml.safe_load(open(args[0])) or {}
        unsupported = set(cfg) - {"interfaces", "loopbacks", "bondethernets"}
        if unsupported:
            die("vppcfg.yaml sections not yet supported by the phase 1 YANG model: " + ", ".join(sorted(unsupported)))
        sys.stdout.write(cfg_to_xml(cfg))
    elif verb == "aspath-check" and len(args) == 2 and args[0] in ("regex", "mask"):
        try:
            mask = aspath_entry_mask({"regex" if args[0] == "regex" else "bird-mask": args[1]})
            if args[0] == "regex":
                print(("Info: t" if style == "vrp" else "T") + f"ranslated to the BIRD path mask {mask}")
        except ValueError as ex:
            die(("Error: " if style == "vrp" else "% ") + str(ex))
    elif verb == "render-bird" and len(args) == 1:
        sys.stdout.write(render_bird(xml_to_bgp(args[0])))
    elif verb == "bgp-summary" and len(args) <= 1 and (not args or args[0] in ("ipv4", "ipv6")):
        cmd_bgp_summary(style, args or ["ipv4", "ipv6"])
    elif verb == "bgp-neighbor" and len(args) == 1:
        cmd_bgp_neighbor(args[0])
    elif verb == "rpki-session" and len(args) <= 1:
        cmd_rpki_session(style, *args)
    elif verb == "rpki-table" and len(args) == 1:
        cmd_rpki_table(args[0], style)
    elif verb == "rpki-validate" and len(args) == 2:
        cmd_rpki_validate(args[0], args[1], style)
    elif verb == "render" and len(args) == 1:
        sys.stdout.write(render_yaml(xml_to_cfg(args[0])))
    elif verb == "show-config" and len(args) == 1:
        cmd_show_config(args[0], style, only)
    elif verb == "show-list" and len(args) == 2 and args[1] in ("static4", "static6"):
        cmd_show_static(args[0], int(args[1][-1]), style)
    elif verb == "show-list" and len(args) in (2, 3) and args[1] in ("ip", "ipv6", "as-path", "community",
                                                                     "large-community"):
        cmd_show_list(args[0], args[1], style, *args[2:])
    elif verb == "diff" and len(args) == 2:
        cmd_diff(*args, style=style)
    elif verb == "changed" and len(args) == 2:
        cmd_changed(*args)
    elif verb == "vppctl" and args:
        cmd_vppctl(args, style)
    elif verb == "ip-brief" and not args:
        cmd_ip_brief(style)
    elif verb == "banner" and not args:
        cmd_banner(style)
    else:
        die(__doc__, 2)


if __name__ == "__main__":
    main()
