"""clixon-vppcfg: bridge between the Clixon datastore (XML, vppcfg.yang and vppcfg-bgp.yang models),
vppcfg and BIRD.

Called by the backend plugin (validate/apply) and the CLI plugin (show-config/diff/ip-brief).

  clixon-vppcfg validate <cfg.xml>       vppcfg check + plan against the running VPP, BGP checks and
                                         'bird -p' on the rendered BIRD configuration; errors to stderr
  clixon-vppcfg apply <cfg.xml>          write /etc/vpp/vppcfg.yaml, vppcfg apply, regenerate the boot file;
                                         write /etc/bird/bird-clixon.conf and 'birdc configure' if it changed
  clixon-vppcfg render-bird <cfg.xml>    print the rendered BIRD configuration (debugging)
  clixon-vppcfg bgp-neighbor <peer>      'birdc show protocols all' for a neighbor address or protocol name
  clixon-vppcfg bgp-summary [--style cisco|vrp] [ipv4|ipv6]
                                         BGP peers per address family (show bgp all summary /
                                         display bgp all summary), from 'birdc show protocols all'
  clixon-vppcfg import <vppcfg.yaml>     print a Clixon XML datastore from vppcfg.yaml (initial migration)
  clixon-vppcfg render <cfg.xml>         print the rendered YAML (debugging)
  clixon-vppcfg show-config <cfg.xml> [--style cisco|vrp] [--if NAME]
                                         show the configuration (optionally one interface)
  clixon-vppcfg diff <a.xml> <b.xml> [--style cisco|vrp]
                                         unified diff of the rendered configuration from a to b
  clixon-vppcfg changed <a.xml> <b.xml>  exit 1 if a and b differ, 0 if identical
  clixon-vppcfg aspath-check regex|mask <pattern> [--style cisco|vrp]
                                         check an AS-path pattern (CLI): show the BIRD path mask of a
                                         regular expression, or the error and exit 1
  clixon-vppcfg vppctl [--style cisco|vrp] <command...>
                                         run vppctl; with vrp, show Eth-TrunkN/LoopBackN names
  clixon-vppcfg ip-brief [--style cisco|vrp]
                                         summary of VPP interfaces and their addresses
"""
import difflib
import grp
import ipaddress
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET
from xml.sax.saxutils import escape

import yaml

NS = "urn:clixon-vppcfg:params:xml:ns:yang:vppcfg"
VPPCFG = "/usr/local/sbin/vppcfg"
VPPCTL = "/usr/bin/vppctl"
YAML_PATH = "/etc/vpp/vppcfg.yaml"
BOOT_PATH = "/etc/vpp/config/vppcfg.vpp"
HISTORY_DIR = "/var/lib/clixon-vppcfg/history"
HISTORY_KEEP = 100
VPP_API_SOCK = "/run/vpp/api.sock"

BGP_NS = "urn:clixon-vppcfg:params:xml:ns:yang:vppcfg-bgp"
BIRD = "/usr/sbin/bird"
BIRDC = "/usr/sbin/birdc"
BIRD_CONF = "/etc/bird/bird.conf"
BIRD_GEN = "/etc/bird/bird-clixon.conf"
BIRD_INCLUDE = f'include "{BIRD_GEN}";'

INT_LEAVES = {"mtu", "dot1q", "dot1ad", "inner-dot1q"}
BOOL_LEAVES = {"mpls", "sflow", "exact-match"}

# Field order in YAML and XML (follows the leaf order in vppcfg.yang).
IF_ORDER = ["description", "mac", "lcp", "mtu", "addresses", "unnumbered", "l2xc", "state", "mpls",
            "device-type", "sflow", "sub-interfaces"]
SUB_ORDER = ["description", "lcp", "mtu", "addresses", "unnumbered", "encapsulation", "l2xc", "state", "mpls"]
LOOP_ORDER = ["description", "mac", "lcp", "mtu", "addresses", "unnumbered", "mpls"]
BOND_ORDER = ["description", "mac", "interfaces", "mode", "load-balance"]
ENCAP_ORDER = ["dot1q", "dot1ad", "inner-dot1q", "exact-match"]

HEADER = """\
# /etc/vpp/vppcfg.yaml — GENERATED by clixon-vppcfg from the Clixon datastore.
# Do not edit by hand: changes are overwritten on the next commit.
# Change the configuration with the `rtr` CLI (configure terminal ... commit).
"""


def die(msg, code=1):
    print(msg.rstrip(), file=sys.stderr)
    sys.exit(code)


def local(tag):
    return tag.rsplit("}", 1)[-1]


def natural_key(s):
    return [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", str(s))]


# ---------------------------------------------------------------------------
# XML (Clixon datastore) -> dict (vppcfg.yaml structure)
# ---------------------------------------------------------------------------

def leaf_value(name, text):
    text = (text or "").strip()
    if name in INT_LEAVES:
        return int(text)
    if name in BOOL_LEAVES:
        return text == "true"
    return text


def element_to_dict(el, order, leaflist_map, nested=None):
    """Convert one XML list entry to a vppcfg dict. leaflist_map: XML leaf-list name -> YAML key."""
    d = {}
    for child in el:
        n = local(child.tag)
        if n in ("name", "id"):
            continue
        if n in leaflist_map:
            d.setdefault(leaflist_map[n], []).append((child.text or "").strip())
        elif nested and n in nested:
            nested[n](child, d)
        else:
            d[n] = leaf_value(n, child.text)
    return {k: d[k] for k in order if k in d}


def encap_to_dict(el, d):
    e = {local(c.tag): leaf_value(local(c.tag), c.text) for c in el}
    if e:
        d["encapsulation"] = {k: e[k] for k in ENCAP_ORDER if k in e}


def sub_to_dict(el, d):
    sid = int(el.findtext(f"{{{NS}}}id"))
    d.setdefault("sub-interfaces", {})[sid] = element_to_dict(
        el, SUB_ORDER, {"address": "addresses"}, {"encapsulation": encap_to_dict})


def xml_to_cfg(path):
    root = ET.parse(path).getroot()
    cfg = {}
    for top in root.iter():
        n = local(top.tag)
        if n == "interfaces" and top.tag.startswith(f"{{{NS}}}"):
            for el in top:
                name = el.findtext(f"{{{NS}}}name")
                cfg.setdefault("interfaces", {})[name] = element_to_dict(
                    el, IF_ORDER, {"address": "addresses"}, {"sub-interface": sub_to_dict})
        elif n == "loopbacks":
            for el in top:
                name = el.findtext(f"{{{NS}}}name")
                cfg.setdefault("loopbacks", {})[name] = element_to_dict(el, LOOP_ORDER, {"address": "addresses"})
        elif n == "bondethernets":
            for el in top:
                name = el.findtext(f"{{{NS}}}name")
                cfg.setdefault("bondethernets", {})[name] = element_to_dict(el, BOND_ORDER, {"interface": "interfaces"})
    # vppcfg treats an empty interface dict as missing ("if not iface"), and get_admin_state() even
    # as admin down. An entry without settings means "exists with defaults", so render it with the
    # default admin state.
    for body in cfg.get("interfaces", {}).values():
        if not body:
            body["state"] = "up"
        for sub in body.get("sub-interfaces", {}).values():
            if not sub:
                sub["state"] = "up"
    # Stable order: bondethernets, loopbacks, interfaces; names in natural order.
    out = {}
    for section in ("bondethernets", "loopbacks", "interfaces"):
        if section in cfg:
            items = sorted(cfg[section].items(), key=lambda kv: natural_key(kv[0]))
            out[section] = {}
            for name, body in items:
                if "sub-interfaces" in body:
                    body["sub-interfaces"] = dict(sorted(body["sub-interfaces"].items()))
                out[section][name] = body
    return out


def render_yaml(cfg):
    if not cfg:
        return HEADER + "{}\n"
    return HEADER + yaml.safe_dump(cfg, sort_keys=False, default_flow_style=False, width=200)


# ---------------------------------------------------------------------------
# dict (vppcfg.yaml) -> Clixon XML datastore (initial migration)
# ---------------------------------------------------------------------------

def xml_leaf(name, value):
    if isinstance(value, bool):
        value = "true" if value else "false"
    return f"<{name}>{escape(str(value))}</{name}>"


def dict_to_xml(body, order, leaflist_map, nested=None):
    parts = []
    for k in order:
        if k not in body:
            continue
        v = body[k]
        if k in leaflist_map:
            parts += [xml_leaf(leaflist_map[k], x) for x in v]
        elif nested and k in nested:
            parts.append(nested[k](v))
        else:
            parts.append(xml_leaf(k, v))
    return "".join(parts)


def encap_xml(e):
    return "<encapsulation>" + "".join(xml_leaf(k, e[k]) for k in ENCAP_ORDER if k in e) + "</encapsulation>"


def subs_xml(subs):
    return "".join(
        f"<sub-interface><id>{sid}</id>"
        + dict_to_xml(b or {}, SUB_ORDER, {"addresses": "address"}, {"encapsulation": encap_xml})
        + "</sub-interface>" for sid, b in sorted(subs.items()))


def cfg_to_xml(cfg):
    out = ["<config>"]
    if cfg.get("interfaces"):
        out.append(f'<interfaces xmlns="{NS}">')
        for name, b in cfg["interfaces"].items():
            out.append(f"<interface><name>{escape(name)}</name>"
                       + dict_to_xml(b or {}, IF_ORDER, {"addresses": "address"}, {"sub-interfaces": subs_xml})
                       + "</interface>")
        out.append("</interfaces>")
    if cfg.get("loopbacks"):
        out.append(f'<loopbacks xmlns="{NS}">')
        for name, b in cfg["loopbacks"].items():
            out.append(f"<loopback><name>{escape(name)}</name>"
                       + dict_to_xml(b or {}, LOOP_ORDER, {"addresses": "address"}) + "</loopback>")
        out.append("</loopbacks>")
    if cfg.get("bondethernets"):
        out.append(f'<bondethernets xmlns="{NS}">')
        for name, b in cfg["bondethernets"].items():
            out.append(f"<bondethernet><name>{escape(name)}</name>"
                       + dict_to_xml(b or {}, BOND_ORDER, {"interfaces": "interface"}) + "</bondethernet>")
        out.append("</bondethernets>")
    out.append("</config>")
    return "\n".join(out) + "\n"


# ---------------------------------------------------------------------------
# vppcfg
# ---------------------------------------------------------------------------

def vppcfg(*args):
    return subprocess.run([VPPCFG, "-q", *args], capture_output=True, text=True)


def clean_errors(text):
    """Keep the core of vppcfg messages: '[ERROR   ] module: message' -> 'message'."""
    lines = []
    for line in text.splitlines():
        m = re.match(r"\[(ERROR|WARNING)\s*\]\s+[\w.]+:\s*(.*)", line)
        if m:
            if m.group(2) not in ("Configuration is not valid, bailing",):
                lines.append(m.group(2))
        elif line.strip():
            lines.append(line.strip())
    return "\n".join(lines)


def wait_vpp(timeout=90):
    end = time.time() + timeout
    while time.time() < end:
        if os.path.exists(VPP_API_SOCK) and subprocess.run([VPPCTL, "show", "version"], capture_output=True).returncode == 0:
            return True
        time.sleep(1)
    return False


def write_atomic(path, text, mode=0o644):
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".clixon-vppcfg-")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def check_and_plan(yaml_path):
    r = vppcfg("check", "-c", yaml_path)
    if r.returncode != 0:
        return clean_errors(r.stderr + r.stdout) or "vppcfg check failed"
    if not wait_vpp():
        return "VPP is not running (API not responding): cannot validate the configuration against the dataplane"
    with tempfile.NamedTemporaryFile("r", suffix=".vpp") as plan:
        r = vppcfg("plan", "-c", yaml_path, "-o", plan.name)
        if r.returncode != 0:
            return clean_errors(r.stderr + r.stdout) or "vppcfg plan failed"
    return None


def cmd_validate(xml_path):
    cfg = xml_to_cfg(xml_path)
    with tempfile.NamedTemporaryFile("w", suffix=".yaml", delete=False) as f:
        f.write(render_yaml(cfg))
        tmp = f.name
    try:
        err = check_and_plan(tmp)
    finally:
        os.unlink(tmp)
    if err:
        die("vppcfg rejected the configuration:\n" + err)
    bgp = xml_to_bgp(xml_path)
    errors = bgp_errors(bgp)
    if errors:
        die("BGP configuration is invalid:\n" + "\n".join(errors))
    err = bird_check(render_bird(bgp))
    if err:
        die("BIRD rejected the configuration:\n" + err)


def cmd_apply(xml_path):
    cfg = xml_to_cfg(xml_path)
    text = render_yaml(cfg)
    old = open(YAML_PATH).read() if os.path.exists(YAML_PATH) else None
    write_atomic(YAML_PATH, text)
    err = check_and_plan(YAML_PATH)
    if not err:
        r = vppcfg("apply", "-c", YAML_PATH)
        if r.returncode != 0:
            err = clean_errors(r.stderr + r.stdout) or "vppcfg apply failed"
    if err:
        if old is not None:
            write_atomic(YAML_PATH, old)
        die("Failed to apply to VPP:\n" + err)
    r = vppcfg("plan", "--novpp", "-c", YAML_PATH, "-o", BOOT_PATH)
    if r.returncode != 0:
        die("Applied to VPP, but failed to write the boot file " + BOOT_PATH + ":\n" + clean_errors(r.stderr))
    # plan --novpp does not tag physical interfaces (it creates nothing for them); without the tags
    # 'vppcfg plan' is not empty after every VPP restart
    phys = [n for n in cfg.get("interfaces", {}) if "." not in n]
    if phys:
        with open(BOOT_PATH, "a") as f:
            f.write(f"comment {{ clixon-vppcfg: tag {len(phys)} physical interface(s) }}\n")
            f.writelines(f"set interface tag {n} vppcfg\n" for n in phys)
    if old != text:
        os.makedirs(HISTORY_DIR, exist_ok=True)
        shutil.copy(YAML_PATH, os.path.join(HISTORY_DIR, time.strftime("%Y%m%d-%H%M%S") + ".yaml"))
        hist = sorted(os.listdir(HISTORY_DIR))
        for name in hist[:-HISTORY_KEEP]:
            os.unlink(os.path.join(HISTORY_DIR, name))
    subprocess.run(["systemctl", "reload", "govpp-snmp-agentx"], capture_output=True)
    bgp = xml_to_bgp(xml_path)
    errors = bgp_errors(bgp)
    if errors:
        die("BGP configuration is invalid:\n" + "\n".join(errors))
    err = bird_apply(render_bird(bgp))
    if err:
        die("Failed to apply to BIRD:\n" + err)


# ---------------------------------------------------------------------------
# BGP (vppcfg-bgp.yang) -> BIRD
# ---------------------------------------------------------------------------

BGP_LISTS = {"network": "prefix", "peer-group": "name", "neighbor": "address", "prefix-list": "name",
             "entry": "seq", "community-list": "name", "large-community-list": "name", "as-path-list": "name",
             "route-policy": "name", "node": "seq"}
BGP_LEAFLISTS = {"community", "large-community"}
BGP_INTS = {"local-as", "remote-as", "multihop", "hold-time", "keepalive", "max-prefix", "seq", "ge", "le",
            "as-path-contains", "origin-as", "local-preference", "med"}
BGP_BOOLS = {"activate", "next-hop-self", "bfd", "shutdown"}
PEER_KEYS = ["remote-as", "description", "source-address", "password", "multihop", "bfd", "hold-time",
             "keepalive", "shutdown"]
AF_KEYS = ["activate", "import-policy", "export-policy", "import-filter", "export-filter", "max-prefix",
           "next-hop-self"]


def bgp_elem(el):
    d = {}
    for c in el:
        n = local(c.tag)
        # peer-group, prefix-list, (large-)community-list and as-path-list are lists at the top level but also leaves
        # (references) inside neighbor and match: an element without children is always a leaf.
        if n in BGP_LISTS and len(c):
            item = bgp_elem(c)
            key = item.pop(BGP_LISTS[n])
            d.setdefault(n, {})[key] = item
        elif n in BGP_LEAFLISTS:
            d.setdefault(n, []).append((c.text or "").strip())
        elif len(c):
            d[n] = bgp_elem(c)
        else:
            t = (c.text or "").strip()
            d[n] = int(t) if n in BGP_INTS else (t == "true") if n in BGP_BOOLS else t
    return d


def xml_to_bgp(path):
    root = ET.parse(path).getroot()
    for el in root.iter(f"{{{BGP_NS}}}routing"):
        return bgp_elem(el)
    return {}


def is_ip(s):
    try:
        ipaddress.ip_address(s)
        return True
    except ValueError:
        return False


def effective_peer(bgp, addr):
    """Neighbor settings merged over its peer-group's settings."""
    n = bgp.get("neighbor", {}).get(addr, {})
    g = bgp.get("peer-group", {}).get(n.get("peer-group"), {}) if n.get("peer-group") else {}
    eff = {k: n.get(k, g.get(k)) for k in PEER_KEYS if k in n or k in g}
    for af in ("ipv4", "ipv6"):
        a, b = g.get(af, {}), n.get(af, {})
        eff[af] = {k: b.get(k, a.get(k)) for k in AF_KEYS if k in a or k in b}
    return eff


def af_active(addr, af, afcfg):
    default = ipaddress.ip_address(addr).version == (4 if af == "ipv4" else 6)
    return afcfg.get("activate", default)


def bgp_errors(r):
    """Semantic checks with messages in CLI terms (BIRD's own messages refer to generated names)."""
    errs = []
    bgp = r.get("bgp", {})
    pls, cls, rps = r.get("prefix-list", {}), r.get("community-list", {}), r.get("route-policy", {})
    lcls = r.get("large-community-list", {})
    apls = r.get("as-path-list", {})
    for name, al in apls.items():
        for seq, e in al.get("entry", {}).items():
            if "action" not in e:
                errs.append(f"as-path-list {name} seq {seq}: permit/deny is required")
            try:
                aspath_entry_mask(e)
            except ValueError as ex:
                errs.append(f"as-path-list {name} seq {seq}: {ex}")
    for name, cl in lcls.items():
        for c in cl.get("large-community", []):
            if not lc_ok(c):
                errs.append(f"large-community-list {name}: {c}: each part must be at most 4294967295")
    if (bgp.get("neighbor") or bgp.get("peer-group") or bgp.get("network")) and "local-as" not in bgp:
        errs.append("router bgp: the local AS number is not set")
    for p in bgp.get("network", {}):
        try:
            ipaddress.ip_network(p, strict=True)
        except ValueError as e:
            errs.append(f"network {p}: {e}")
    for name, pl in pls.items():
        for seq, e in pl.get("entry", {}).items():
            where = f"prefix-list {name} seq {seq}"
            if "action" not in e or "prefix" not in e:
                errs.append(f"{where}: permit/deny and a prefix are required")
                continue
            try:
                net = ipaddress.ip_network(e["prefix"], strict=False)
            except ValueError as ex:
                errs.append(f"{where}: {ex}")
                continue
            ge, le = e.get("ge"), e.get("le")
            if ge is not None and not net.prefixlen <= ge <= net.max_prefixlen:
                errs.append(f"{where}: ge {ge} must be between {net.prefixlen} and {net.max_prefixlen}")
            if le is not None and not net.prefixlen <= le <= net.max_prefixlen:
                errs.append(f"{where}: le {le} must be between {net.prefixlen} and {net.max_prefixlen}")
            if ge is not None and le is not None and ge > le:
                errs.append(f"{where}: ge {ge} is larger than le {le}")
    for name, rp in rps.items():
        for seq, node in rp.get("node", {}).items():
            where = f"route-policy {name} node {seq}"
            if "action" not in node:
                errs.append(f"{where}: permit/deny is required")
            m = node.get("match", {})
            if "prefix-list" in m and m["prefix-list"] not in pls:
                errs.append(f"{where}: prefix-list {m['prefix-list']} does not exist")
            if "community-list" in m and m["community-list"] not in cls:
                errs.append(f"{where}: community-list {m['community-list']} does not exist")
            if "as-path-list" in m and m["as-path-list"] not in apls:
                errs.append(f"{where}: as-path-list {m['as-path-list']} does not exist")
            if "large-community-list" in m and m["large-community-list"] not in lcls:
                errs.append(f"{where}: large-community-list {m['large-community-list']} does not exist")
            for c in node.get("set", {}).get("large-community", []):
                if not lc_ok(c):
                    errs.append(f"{where}: large community {c}: each part must be at most 4294967295")
            st = node.get("set", {})
            if any(not 1 <= int(a) <= 0xFFFFFFFF for a in st.get("prepend", "").split()):
                errs.append(f"{where}: AS-path prepend {st['prepend']}: AS numbers must be 1..4294967295")

    for kind, objs, prefix in (("prefix-list", pls, "cx_pl_"), ("as-path-list", apls, "cx_ap_"),
                               ("route-policy", rps, "cx_rp_")):
        seen = {}
        for name in objs:
            ident = bird_ident(prefix, name)
            if ident in seen:
                errs.append(f"{kind} {name} and {seen[ident]}: names differ only in '-' and '_'")
            seen[ident] = name

    def check_peer(kind, name, p):
        for af in ("ipv4", "ipv6"):
            for d in ("import", "export"):
                pol = p.get(af, {}).get(f"{d}-policy")
                if pol and pol not in rps:
                    errs.append(f"{kind} {name} {af}: route-policy {pol} ({d}) does not exist")
        if "source-address" in p and not is_ip(p["source-address"]):
            errs.append(f"{kind} {name}: source address {p['source-address']} is not an IP address")

    for name, g in bgp.get("peer-group", {}).items():
        check_peer("peer-group", name, g)
    protos = {}
    for addr, n in bgp.get("neighbor", {}).items():
        if not is_ip(addr):
            errs.append(f"neighbor {addr}: not an IP address")
            continue
        if n.get("peer-group") and n["peer-group"] not in bgp.get("peer-group", {}):
            errs.append(f"neighbor {addr}: peer-group {n['peer-group']} does not exist")
        check_peer("neighbor", addr, n)
        eff = effective_peer(bgp, addr)
        if "remote-as" not in eff:
            errs.append(f"neighbor {addr}: remote AS is not set (on the neighbor or its peer-group)")
        if not any(af_active(addr, af, eff[af]) for af in ("ipv4", "ipv6")):
            errs.append(f"neighbor {addr}: no address family is activated")
        proto = bird_proto(addr, n)
        if proto in protos or proto in ("cx_bfd", "cx_originate4", "cx_originate6"):
            errs.append(f"neighbor {addr}: BIRD name {proto} is already used"
                        + (f" by neighbor {protos[proto]}" if proto in protos else " by clixon-vppcfg"))
        protos[proto] = addr
        if eff.get("bfd") and "multihop" in eff and "source-address" not in eff:
            errs.append(f"neighbor {addr}: BFD on a multihop session needs a source address "
                        "(update-source / connect-interface)")
    return errs


def bird_ident(prefix, s):
    return prefix + re.sub(r"[^A-Za-z0-9]", "_", str(s))


def bird_proto(addr, n=None):
    """BIRD protocol name of a neighbor: its configured name, else cx_<address>."""
    return (n or {}).get("name") or bird_ident("cx_", addr)


ASPATH_TOKEN = re.compile(r"_|\.\*|\[0-9\]\+|\d+|\(\d+(?:\|\d+)*\)")
BIRD_MASK = re.compile(r"\[=[0-9 *?\[\],.]*=\]")


def aspath_mask(regex):
    """Translate a Cisco/Huawei AS-path regular expression to a BIRD path mask (ValueError if not possible).
    Supported: ^ and $ anchors, _ (AS boundary), AS numbers, (A|B|C) alternatives, [0-9]+ (any one AS)
    and .* (any number of ASes)."""
    s = regex
    start, end = s.startswith("^"), s.endswith("$")
    s = s[1 if start else 0:len(s) - (1 if end else 0)]
    toks, i = [], 0
    while i < len(s):
        m = ASPATH_TOKEN.match(s, i)
        if not m:
            raise ValueError(f"'{s[i:]}' cannot be translated to a BIRD path mask "
                             "(supported: ^ $ _ .* [0-9]+ AS numbers and (A|B) alternatives); use bird-mask")
        toks.append(m.group())
        i = m.end()
    items = []
    for k, t in enumerate(toks):
        if t == "_":
            continue
        if t == ".*":
            items.append("*")
            continue
        left = toks[k - 1] == "_" if k else start
        right = toks[k + 1] == "_" if k + 1 < len(toks) else end
        if not (left and right):
            raise ValueError(f"'{t}' must have _ (or ^ / $) on both sides; otherwise it would also match "
                             "part of a longer AS number")
        if t == "[0-9]+":
            items.append("?")
            continue
        asns = [int(a) for a in t.strip("()").split("|")]
        if any(a > 0xFFFFFFFF for a in asns):
            raise ValueError(f"AS number in '{t}' is larger than 4294967295")
        items.append(str(asns[0]) if len(asns) == 1 else "[" + ", ".join(map(str, asns)) + "]")
    if not start and items[:1] != ["*"]:
        items.insert(0, "*")
    if not end and items[-1:] != ["*"]:
        items.append("*")
    items = [x for k, x in enumerate(items) if not (x == "*" and k and items[k - 1] == "*")]
    return "[= " + " ".join(items) + " =]" if items else "[= =]"


def cli_regex(rx):
    """A regular expression as typed in the CLI: quoted when it contains | (else taken as a pipe)."""
    return f'"{rx}"' if "|" in rx else rx


def aspath_entry_mask(e):
    """BIRD path mask of an as-path-list entry (ValueError if invalid)."""
    if "regex" in e:
        return aspath_mask(e["regex"])
    if "bird-mask" in e:
        if not BIRD_MASK.fullmatch(e["bird-mask"]):
            raise ValueError(f"bird-mask {e['bird-mask']}: expected [= ... =] with AS numbers, ranges A..B, "
                             "sets [A, B], ? and *")
        return e["bird-mask"]
    raise ValueError("a regular expression or a bird-mask is required")


def bird_pattern(prefix, ge=None, le=None):
    net = ipaddress.ip_network(prefix, strict=False)
    base = f"{net.network_address}/{net.prefixlen}"
    if ge is None and le is None:
        return base
    return f"{base}{{{ge if ge is not None else net.prefixlen},{le if le is not None else net.max_prefixlen}}}"


def bird_community(c):
    a, b = c.split(":")
    return f"({int(a)},{int(b)})"


def lc_ok(c):
    return all(int(x) <= 0xFFFFFFFF for x in c.split(":"))


def bird_large_community(c):
    return f"({', '.join(str(int(x)) for x in c.split(':'))})"


def render_bird(r):
    out = ["# /etc/bird/bird-clixon.conf — GENERATED by clixon-vppcfg from the Clixon datastore.",
           "# Do not edit by hand: changes are overwritten on the next commit.",
           "# Change BGP with the `rtr` or `vrp` CLI; hand-written configuration stays in bird.conf.", ""]
    if "router-id" in r:
        out += [f"router id {r['router-id']};", ""]
    bgp = r.get("bgp", {})
    las = bgp.get("local-as")
    for name, pl in r.get("prefix-list", {}).items():
        out.append(f"function {bird_ident('cx_pl_', name)}() -> bool {{")
        for seq in sorted(pl.get("entry", {})):
            e = pl["entry"][seq]
            fam = "NET_IP6" if ":" in e["prefix"] else "NET_IP4"
            ret = "true" if e["action"] == "permit" else "false"
            out.append(f"  if net.type = {fam} then {{ if net ~ [ {bird_pattern(e['prefix'], e.get('ge'), e.get('le'))} ]"
                       f" then return {ret}; }}  # seq {seq}")
        out += ["  return false;", "}", ""]
    for name, al in r.get("as-path-list", {}).items():
        out.append(f"function {bird_ident('cx_ap_', name)}() -> bool {{")
        for seq in sorted(al.get("entry", {})):
            e = al["entry"][seq]
            src = f"regex {e['regex']}" if "regex" in e else "bird-mask"
            out.append(f"  if bgp_path ~ {aspath_entry_mask(e)} then return {'true' if e['action'] == 'permit' else 'false'};"
                       f"  # seq {seq} {src}")
        out += ["  return false;", "}", ""]
    for name, rp in r.get("route-policy", {}).items():
        out.append(f"filter {bird_ident('cx_rp_', name)} {{")
        for seq in sorted(rp.get("node", {})):
            node = rp["node"][seq]
            m, st = node.get("match", {}), node.get("set", {})
            conds = []
            if "prefix-list" in m:
                conds.append(f"{bird_ident('cx_pl_', m['prefix-list'])}()")
            if "community-list" in m:
                comms = r.get("community-list", {}).get(m["community-list"], {}).get("community", [])
                conds.append(f"bgp_community ~ [ {', '.join(bird_community(c) for c in comms)} ]" if comms else "false")
            if "large-community-list" in m:
                lcs = r.get("large-community-list", {}).get(m["large-community-list"], {}).get("large-community", [])
                conds.append(f"bgp_large_community ~ [ {', '.join(bird_large_community(c) for c in lcs)} ]"
                             if lcs else "false")
            if "as-path-list" in m:
                conds.append(f"{bird_ident('cx_ap_', m['as-path-list'])}()")
            if "as-path-contains" in m:
                conds.append(f"bgp_path ~ [= * {m['as-path-contains']} * =]")
            if "origin-as" in m:
                conds.append(f"bgp_path.last = {m['origin-as']}")
            body = []
            if node.get("action") == "permit":
                if "local-preference" in st:
                    body.append(f"bgp_local_pref = {st['local-preference']};")
                if "med" in st:
                    body.append(f"bgp_med = {st['med']};")
                for c in st.get("community", []):
                    body.append(f"bgp_community.add({bird_community(c)});")
                for c in st.get("large-community", []):
                    body.append(f"bgp_large_community.add({bird_large_community(c)});")
                # prepend() adds in front: the last AS first, so the first ends up leftmost
                body += [f"bgp_path.prepend({a});" for a in reversed(st.get("prepend", "").split())]
                body.append("accept;")
            else:
                body.append("reject;")
            out.append(f"  # node {seq} {node.get('action')}")
            if conds:
                out.append(f"  if {' && '.join(conds)} then {{")
                out += [f"    {b}" for b in body]
                out.append("  }")
            else:
                out += [f"  {b}" for b in body]
        out += ["  reject;", "}", ""]
    nets = list(bgp.get("network", {}))
    for af, ver in (("ipv4", 4), ("ipv6", 6)):
        fam = [p for p in nets if ipaddress.ip_network(p).version == ver]
        if fam:
            out.append(f"protocol static cx_originate{ver} {{")
            out.append(f"  {af};")
            out += [f"  route {p} blackhole;" for p in sorted(fam, key=natural_key)]
            out += ["}", ""]
    neighbors = bgp.get("neighbor", {})
    effs = {a: effective_peer(bgp, a) for a in neighbors}
    if any(e.get("bfd") for e in effs.values()):
        out += ["protocol bfd cx_bfd {", "}", ""]
    for addr in sorted(neighbors, key=lambda a: (ipaddress.ip_address(a).version, ipaddress.ip_address(a))):
        e = effs[addr]
        out.append(f"protocol bgp {bird_proto(addr, neighbors[addr])} {{")
        if "description" in e:
            out.append(f'  description "{e["description"]}";')
        out.append(f"  local as {las};")
        out.append(f"  neighbor {addr} as {e['remote-as']};")
        if "source-address" in e:
            out.append(f"  source address {e['source-address']};")
        if "password" in e:
            out.append(f'  password "{e["password"]}";')
            out.append("  authentication md5;")
        if "multihop" in e:
            out.append(f"  multihop {e['multihop']};")
        if e.get("bfd"):
            out.append("  bfd on;")
        if "hold-time" in e:
            out.append(f"  hold time {e['hold-time']};")
        if "keepalive" in e:
            out.append(f"  keepalive time {e['keepalive']};")
        if e.get("shutdown"):
            out.append("  disabled;")
        for af in ("ipv4", "ipv6"):
            a = e[af]
            if not af_active(addr, af, a):
                continue
            ch = []
            for d in ("import", "export"):
                if a.get(f"{d}-filter"):
                    ch.append(f"{d} filter {a[f'{d}-filter']};")
                elif a.get(f"{d}-policy"):
                    ch.append(f"{d} filter {bird_ident('cx_rp_', a[f'{d}-policy'])};")
                else:
                    ch.append(f"{d} none;")
            if "max-prefix" in a:
                ch.append(f"import limit {a['max-prefix']} action restart;")
            if a.get("next-hop-self"):
                ch.append("next hop self;")
            out.append(f"  {af} {{ {' '.join(ch)} }};")
        out += ["}", ""]
    return "\n".join(out).rstrip("\n") + "\n"


def bird_errors(text, gen_path, gen_text):
    """Turn 'bird: <path>:<line>:<col> <message>' into messages with the generated line as context."""
    lines = gen_text.splitlines()
    out = []
    for line in text.splitlines():
        m = re.search(re.escape(gen_path) + r":(\d+):\d+:?\s*(.*)", line)
        if m:
            n = int(m.group(1))
            ctx = lines[n - 1].strip() if 0 < n <= len(lines) else ""
            out.append(f"{m.group(2)} (bird-clixon.conf line {n}: {ctx})")
        elif "<WARN>" not in line and line.strip():
            out.append(re.sub(r"^bird: \S+ \S+ \[\d+\] ", "", line.strip()))
    return "\n".join(out)


def bird_check(text):
    """Parse bird.conf with the candidate bird-clixon.conf ('bird -p'); None if OK."""
    if not os.path.exists(BIRD_CONF):
        return None
    main = open(BIRD_CONF).read()
    if BIRD_INCLUDE not in main:
        if text.count("\n") <= 4:
            return None
        return f"{BIRD_CONF} does not contain: {BIRD_INCLUDE}"
    with tempfile.TemporaryDirectory() as d:
        gen = os.path.join(d, "bird-clixon.conf")
        with open(gen, "w") as f:
            f.write(text)
        conf = os.path.join(d, "bird.conf")
        with open(conf, "w") as f:
            f.write(main.replace(BIRD_INCLUDE, f'include "{gen}";'))
        r = subprocess.run([BIRD, "-p", "-c", conf], capture_output=True, text=True)
        if r.returncode != 0:
            return bird_errors(r.stderr + r.stdout, gen, text) or "bird -p failed"
    return None


def bird_apply(text):
    """Write bird-clixon.conf and reconfigure BIRD if it changed; None if OK."""
    old = open(BIRD_GEN).read() if os.path.exists(BIRD_GEN) else None
    if old == text:
        return None
    write_atomic(BIRD_GEN, text, 0o640)
    try:
        os.chown(BIRD_GEN, 0, grp.getgrnam("bird").gr_gid)
    except KeyError:
        pass
    r = subprocess.run([BIRDC, "configure"], capture_output=True, text=True)
    out = r.stdout + r.stderr
    if "Reconfigured" in out or "Reconfiguration in progress" in out:
        return None
    if "Unable to connect" in out:
        print(f"BIRD is not running; {BIRD_GEN} will be loaded when it starts", file=sys.stderr)
        return None
    if old is not None:
        write_atomic(BIRD_GEN, old, 0o640)
        subprocess.run([BIRDC, "configure"], capture_output=True)
    return "\n".join(l for l in out.splitlines() if "BIRD" not in l or "ready" not in l).strip() or "birdc configure failed"


def cmd_bgp_neighbor(peer):
    name = peer
    if is_ip(peer):
        # The session name may be configured: find the protocol with this neighbor address.
        r = subprocess.run([BIRDC, "show", "protocols", "all"], capture_output=True, text=True)
        name, proto = bird_proto(peer), None
        for line in r.stdout.splitlines():
            m = re.match(r"(\S+)\s+BGP\s", line)
            if m:
                proto = m.group(1)
            m = re.match(r"\s+Neighbor address:\s+(\S+)", line)
            if m and proto and m.group(1).split("%")[0] == str(ipaddress.ip_address(peer)):
                name = proto
                break
    r = subprocess.run([BIRDC, "show", "protocols", "all", name], capture_output=True, text=True)
    sys.stdout.write(r.stdout + r.stderr)


def bird_bgp_sessions(text=None):
    """BGP protocols from 'birdc show protocols all': dicts with name, state, since, bgp-state,
    neighbor, remote-as, local-as, description and channels {ipv4|ipv6: (received, accepted, exported)}."""
    if text is None:
        text = subprocess.run([BIRDC, "show", "protocols", "all"], capture_output=True, text=True).stdout
    sessions, cur, chan = [], None, None
    for line in text.splitlines():
        m = re.match(r"(\S+)\s+(\S+)\s+\S+\s+(\S+)\s+(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)", line)
        if m and not line.startswith(" "):
            cur = None
            if m.group(2) == "BGP":
                cur = {"name": m.group(1), "state": m.group(3), "since": m.group(4), "channels": {}}
                sessions.append(cur)
            continue
        if cur is None:
            continue
        m = re.match(r"\s+([A-Za-z ]+?):\s+(.*)", line)
        if re.match(r"\s+Channel (ipv4|ipv6)", line):
            chan = line.split()[1]
            cur["channels"][chan] = (0, 0, 0)
        elif m:
            key, val = m.group(1), m.group(2).strip()
            if key == "BGP state":
                cur["bgp-state"] = val
            elif key == "Neighbor address":
                cur["neighbor"] = val.split("%")[0]
            elif key == "Neighbor AS":
                cur["remote-as"] = val
            elif key == "Local AS":
                cur["local-as"] = val
            elif key == "Description":
                cur["description"] = val
            elif key == "Routes" and chan:
                n = dict((k, int(v)) for v, k in re.findall(r"(\d+) (imported|filtered|exported)", val))
                cur["channels"][chan] = (n.get("imported", 0) + n.get("filtered", 0), n.get("imported", 0),
                                         n.get("exported", 0))
    return sessions


def updown(since):
    """Time since a BIRD timestamp: hh:mm:ss below one day, else NdNNh."""
    try:
        t = int(time.time() - time.mktime(time.strptime(since, "%Y-%m-%d %H:%M:%S")))
    except ValueError:
        return since
    if t < 86400:
        return f"{t // 3600:02d}:{t % 3600 // 60:02d}:{t % 60:02d}"
    return f"{t // 86400}d{t % 86400 // 3600:02d}h"


def cmd_bgp_summary(style, afs, text=None):
    st = subprocess.run([BIRDC, "show", "status"], capture_output=True, text=True).stdout
    m = re.search(r"Router ID is (\S+)", st)
    rid = m.group(1) if m else "?"
    sessions = bird_bgp_sessions(text)
    las = sorted({s["local-as"] for s in sessions if "local-as" in s}, key=int)
    las = ", ".join(las) or "-"
    out = []
    if style == "vrp":
        out += [f" BGP local router ID        : {rid}", f" Local AS number            : {las}"]
    for af in afs:
        peers = [s for s in sessions if af in s["channels"]]
        peers.sort(key=lambda s: (ipaddress.ip_address(s["neighbor"]).version, ipaddress.ip_address(s["neighbor"]))
                   if is_ip(s.get("neighbor", "")) else (9, s["name"]))
        est = sum(1 for s in peers if s.get("bgp-state") == "Established")
        w = max([15] + [len(s.get("neighbor", "?")) for s in peers])
        title = "IPv4 Unicast" if af == "ipv4" else "IPv6 Unicast"

        def state(s):
            if s["state"] == "down":
                return "Idle(Admin)" if style == "vrp" else "Idle (Admin)"
            return s.get("bgp-state", "?")

        if style == "vrp":
            out += ["", f" Address Family: {title}", " " + "-" * 92,
                    f" Total number of peers      : {len(peers)}",
                    f" Peers in established state : {est}"]
            if peers:
                out += ["", f"  {'Peer':<{w}} {'V':>1} {'AS':>10}  {'Up/Down':>9}  {'State':<12} "
                       f"{'PrefRcv':>8} {'PrefAcc':>8} {'PrefSnt':>8}  Name"]
            for s in peers:
                rcv, acc, snt = s["channels"][af]
                out.append(f"  {s.get('neighbor', '?'):<{w}} 4 {s.get('remote-as', '?'):>10}  {updown(s['since']):>9}  "
                           f"{state(s):<12} {rcv:>8} {acc:>8} {snt:>8}  {s['name']}")
        else:
            out += [f"For address family: {title}",
                    f"BGP router identifier {rid}, local AS number {las}",
                    f"{len(peers)} neighbor(s), {est} established"]
            if peers:
                out += ["", f"{'Neighbor':<{w}} {'V':>1} {'AS':>10} {'Up/Down':>9} {'State/PfxRcd':>14} "
                       f"{'PfxAcc':>8} {'PfxSnt':>8}  Name"]
            for s in peers:
                rcv, acc, snt = s["channels"][af]
                sp = str(rcv) if s.get("bgp-state") == "Established" else state(s)
                out.append(f"{s.get('neighbor', '?'):<{w}} 4 {s.get('remote-as', '?'):>10} {updown(s['since']):>9} "
                           f"{sp:>14} {acc:>8} {snt:>8}  {s['name']}")
            out.append("")
    print("\n".join(out).rstrip())


