"""clixon-vppcfg: bridge between the Clixon datastore (XML, vppcfg.yang model) and vppcfg.

Called by the backend plugin (validate/apply) and the CLI plugin (show-config/diff/ip-brief).

  clixon-vppcfg validate <cfg.xml>       vppcfg check + plan against the running VPP; errors to stderr
  clixon-vppcfg apply <cfg.xml>          write /etc/vpp/vppcfg.yaml, vppcfg apply, regenerate the boot file
  clixon-vppcfg import <vppcfg.yaml>     print a Clixon XML datastore from vppcfg.yaml (initial migration)
  clixon-vppcfg render <cfg.xml>         print the rendered YAML (debugging)
  clixon-vppcfg show-config <cfg.xml> [--style cisco|vrp] [--if NAME]
                                         show the configuration (optionally one interface)
  clixon-vppcfg diff <a.xml> <b.xml> [--style cisco|vrp]
                                         unified diff of the rendered configuration from a to b
  clixon-vppcfg changed <a.xml> <b.xml>  exit 1 if a and b differ, 0 if identical
  clixon-vppcfg vppctl [--style cisco|vrp] <command...>
                                         run vppctl; with vrp, show Eth-TrunkN/LoopBackN names
  clixon-vppcfg ip-brief [--style cisco|vrp]
                                         summary of VPP interfaces and their addresses
"""
import difflib
import ipaddress
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET
from xml.sax.saxutils import escape

import yaml

NS = "urn:clixon-vppcfg:params:xml:ns:yang:vppcfg"
VPPCFG = "/usr/local/sbin/vppcfg"
VPPCTL = "/usr/bin/vppctl"
YAML_PATH = "/etc/vpp/vppcfg.yaml"
BOOT_PATH = "/etc/vpp/config/vppcfg.vpp"
HISTORY_DIR = "/var/lib/clixon-vppcfg/history"
HISTORY_KEEP = 100
VPP_API_SOCK = "/run/vpp/api.sock"

INT_LEAVES = {"mtu", "dot1q", "dot1ad", "inner-dot1q"}
BOOL_LEAVES = {"mpls", "sflow", "exact-match"}

# Field order in YAML and XML (follows the leaf order in vppcfg.yang).
IF_ORDER = ["description", "mac", "lcp", "mtu", "addresses", "unnumbered", "l2xc", "state", "mpls",
            "device-type", "sflow", "sub-interfaces"]
SUB_ORDER = ["description", "lcp", "mtu", "addresses", "unnumbered", "encapsulation", "l2xc", "state", "mpls"]
LOOP_ORDER = ["description", "mac", "lcp", "mtu", "addresses", "unnumbered", "mpls"]
BOND_ORDER = ["description", "mac", "interfaces", "mode", "load-balance"]
ENCAP_ORDER = ["dot1q", "dot1ad", "inner-dot1q", "exact-match"]

HEADER = """\
# /etc/vpp/vppcfg.yaml — GENERATED by clixon-vppcfg from the Clixon datastore.
# Do not edit by hand: changes are overwritten on the next commit.
# Change the configuration with the `rtr` CLI (configure terminal ... commit).
"""


def die(msg, code=1):
    print(msg.rstrip(), file=sys.stderr)
    sys.exit(code)


def local(tag):
    return tag.rsplit("}", 1)[-1]


def natural_key(s):
    return [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", str(s))]


# ---------------------------------------------------------------------------
# XML (Clixon datastore) -> dict (vppcfg.yaml structure)
# ---------------------------------------------------------------------------

def leaf_value(name, text):
    text = (text or "").strip()
    if name in INT_LEAVES:
        return int(text)
    if name in BOOL_LEAVES:
        return text == "true"
    return text


def element_to_dict(el, order, leaflist_map, nested=None):
    """Convert one XML list entry to a vppcfg dict. leaflist_map: XML leaf-list name -> YAML key."""
    d = {}
    for child in el:
        n = local(child.tag)
        if n in ("name", "id"):
            continue
        if n in leaflist_map:
            d.setdefault(leaflist_map[n], []).append((child.text or "").strip())
        elif nested and n in nested:
            nested[n](child, d)
        else:
            d[n] = leaf_value(n, child.text)
    return {k: d[k] for k in order if k in d}


def encap_to_dict(el, d):
    e = {local(c.tag): leaf_value(local(c.tag), c.text) for c in el}
    if e:
        d["encapsulation"] = {k: e[k] for k in ENCAP_ORDER if k in e}


def sub_to_dict(el, d):
    sid = int(el.findtext(f"{{{NS}}}id"))
    d.setdefault("sub-interfaces", {})[sid] = element_to_dict(
        el, SUB_ORDER, {"address": "addresses"}, {"encapsulation": encap_to_dict})


def xml_to_cfg(path):
    root = ET.parse(path).getroot()
    cfg = {}
    for top in root.iter():
        n = local(top.tag)
        if n == "interfaces" and top.tag.startswith(f"{{{NS}}}"):
            for el in top:
                name = el.findtext(f"{{{NS}}}name")
                cfg.setdefault("interfaces", {})[name] = element_to_dict(
                    el, IF_ORDER, {"address": "addresses"}, {"sub-interface": sub_to_dict})
        elif n == "loopbacks":
            for el in top:
                name = el.findtext(f"{{{NS}}}name")
                cfg.setdefault("loopbacks", {})[name] = element_to_dict(el, LOOP_ORDER, {"address": "addresses"})
        elif n == "bondethernets":
            for el in top:
                name = el.findtext(f"{{{NS}}}name")
                cfg.setdefault("bondethernets", {})[name] = element_to_dict(el, BOND_ORDER, {"interface": "interfaces"})
    # Stable order: bondethernets, loopbacks, interfaces; names in natural order.
    out = {}
    for section in ("bondethernets", "loopbacks", "interfaces"):
        if section in cfg:
            items = sorted(cfg[section].items(), key=lambda kv: natural_key(kv[0]))
            out[section] = {}
            for name, body in items:
                if "sub-interfaces" in body:
                    body["sub-interfaces"] = dict(sorted(body["sub-interfaces"].items()))
                out[section][name] = body
    return out


def render_yaml(cfg):
    if not cfg:
        return HEADER + "{}\n"
    return HEADER + yaml.safe_dump(cfg, sort_keys=False, default_flow_style=False, width=200)


# ---------------------------------------------------------------------------
# dict (vppcfg.yaml) -> Clixon XML datastore (initial migration)
# ---------------------------------------------------------------------------

def xml_leaf(name, value):
    if isinstance(value, bool):
        value = "true" if value else "false"
    return f"<{name}>{escape(str(value))}</{name}>"


def dict_to_xml(body, order, leaflist_map, nested=None):
    parts = []
    for k in order:
        if k not in body:
            continue
        v = body[k]
        if k in leaflist_map:
            parts += [xml_leaf(leaflist_map[k], x) for x in v]
        elif nested and k in nested:
            parts.append(nested[k](v))
        else:
            parts.append(xml_leaf(k, v))
    return "".join(parts)


def encap_xml(e):
    return "<encapsulation>" + "".join(xml_leaf(k, e[k]) for k in ENCAP_ORDER if k in e) + "</encapsulation>"


def subs_xml(subs):
    return "".join(
        f"<sub-interface><id>{sid}</id>"
        + dict_to_xml(b or {}, SUB_ORDER, {"addresses": "address"}, {"encapsulation": encap_xml})
        + "</sub-interface>" for sid, b in sorted(subs.items()))


def cfg_to_xml(cfg):
    out = ["<config>"]
    if cfg.get("interfaces"):
        out.append(f'<interfaces xmlns="{NS}">')
        for name, b in cfg["interfaces"].items():
            out.append(f"<interface><name>{escape(name)}</name>"
                       + dict_to_xml(b or {}, IF_ORDER, {"addresses": "address"}, {"sub-interfaces": subs_xml})
                       + "</interface>")
        out.append("</interfaces>")
    if cfg.get("loopbacks"):
        out.append(f'<loopbacks xmlns="{NS}">')
        for name, b in cfg["loopbacks"].items():
            out.append(f"<loopback><name>{escape(name)}</name>"
                       + dict_to_xml(b or {}, LOOP_ORDER, {"addresses": "address"}) + "</loopback>")
        out.append("</loopbacks>")
    if cfg.get("bondethernets"):
        out.append(f'<bondethernets xmlns="{NS}">')
        for name, b in cfg["bondethernets"].items():
            out.append(f"<bondethernet><name>{escape(name)}</name>"
                       + dict_to_xml(b or {}, BOND_ORDER, {"interfaces": "interface"}) + "</bondethernet>")
        out.append("</bondethernets>")
    out.append("</config>")
    return "\n".join(out) + "\n"


# ---------------------------------------------------------------------------
# vppcfg
# ---------------------------------------------------------------------------

def vppcfg(*args):
    return subprocess.run([VPPCFG, "-q", *args], capture_output=True, text=True)


def clean_errors(text):
    """Keep the core of vppcfg messages: '[ERROR   ] module: message' -> 'message'."""
    lines = []
    for line in text.splitlines():
        m = re.match(r"\[(ERROR|WARNING)\s*\]\s+[\w.]+:\s*(.*)", line)
        if m:
            if m.group(2) not in ("Configuration is not valid, bailing",):
                lines.append(m.group(2))
        elif line.strip():
            lines.append(line.strip())
    return "\n".join(lines)


def wait_vpp(timeout=90):
    end = time.time() + timeout
    while time.time() < end:
        if os.path.exists(VPP_API_SOCK) and subprocess.run([VPPCTL, "show", "version"], capture_output=True).returncode == 0:
            return True
        time.sleep(1)
    return False


def write_atomic(path, text, mode=0o644):
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".clixon-vppcfg-")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def check_and_plan(yaml_path):
    r = vppcfg("check", "-c", yaml_path)
    if r.returncode != 0:
        return clean_errors(r.stderr + r.stdout) or "vppcfg check failed"
    if not wait_vpp():
        return "VPP is not running (API not responding): cannot validate the configuration against the dataplane"
    with tempfile.NamedTemporaryFile("r", suffix=".vpp") as plan:
        r = vppcfg("plan", "-c", yaml_path, "-o", plan.name)
        if r.returncode != 0:
            return clean_errors(r.stderr + r.stdout) or "vppcfg plan failed"
    return None


def cmd_validate(xml_path):
    cfg = xml_to_cfg(xml_path)
    with tempfile.NamedTemporaryFile("w", suffix=".yaml", delete=False) as f:
        f.write(render_yaml(cfg))
        tmp = f.name
    try:
        err = check_and_plan(tmp)
    finally:
        os.unlink(tmp)
    if err:
        die("vppcfg rejected the configuration:\n" + err)


def cmd_apply(xml_path):
    cfg = xml_to_cfg(xml_path)
    text = render_yaml(cfg)
    old = open(YAML_PATH).read() if os.path.exists(YAML_PATH) else None
    write_atomic(YAML_PATH, text)
    err = check_and_plan(YAML_PATH)
    if not err:
        r = vppcfg("apply", "-c", YAML_PATH)
        if r.returncode != 0:
            err = clean_errors(r.stderr + r.stdout) or "vppcfg apply failed"
    if err:
        if old is not None:
            write_atomic(YAML_PATH, old)
        die("Failed to apply to VPP:\n" + err)
    r = vppcfg("plan", "--novpp", "-c", YAML_PATH, "-o", BOOT_PATH)
    if r.returncode != 0:
        die("Applied to VPP, but failed to write the boot file " + BOOT_PATH + ":\n" + clean_errors(r.stderr))
    if old != text:
        os.makedirs(HISTORY_DIR, exist_ok=True)
        shutil.copy(YAML_PATH, os.path.join(HISTORY_DIR, time.strftime("%Y%m%d-%H%M%S") + ".yaml"))
        hist = sorted(os.listdir(HISTORY_DIR))
        for name in hist[:-HISTORY_KEEP]:
            os.unlink(os.path.join(HISTORY_DIR, name))
    subprocess.run(["systemctl", "reload", "govpp-snmp-agentx"], capture_output=True)


# ---------------------------------------------------------------------------
# Cisco-style output
# ---------------------------------------------------------------------------

def cisco_lines(cfg):
    out = []

    def l3(body, indent=" "):
        if "description" in body:
            out.append(f"{indent}description {body['description']}")
        if "mac" in body:
            out.append(f"{indent}mac-address {body['mac']}")
        if "mtu" in body:
            out.append(f"{indent}mtu {body['mtu']}")
        for a in body.get("addresses", []):
            out.append(f"{indent}{'ipv6' if ':' in a else 'ip'} address {a}")
        if "unnumbered" in body:
            out.append(f"{indent}unnumbered {body['unnumbered']}")
        if "lcp" in body:
            out.append(f"{indent}lcp {body['lcp']}")
        if "l2xc" in body:
            out.append(f"{indent}l2xc {body['l2xc']}")
        if body.get("mpls"):
            out.append(f"{indent}mpls enable")
        if body.get("sflow"):
            out.append(f"{indent}sflow enable")
        if body.get("state") == "down":
            out.append(f"{indent}shutdown")

    bonds = cfg.get("bondethernets", {})
    ifs = cfg.get("interfaces", {})
    for name in sorted(set(bonds) | set(ifs), key=natural_key):
        out.append(f"interface {name}")
        b = bonds.get(name)
        if b is not None:
            if "description" in b and "description" not in ifs.get(name, {}):
                out.append(f" description {b['description']}")
            if "mode" in b:
                out.append(f" mode {b['mode']}")
            if "load-balance" in b:
                out.append(f" load-balance {b['load-balance']}")
            for m in b.get("interfaces", []):
                out.append(f" member {m}")
        body = ifs.get(name, {})
        l3(body)
        out.append("!")
        for sid, sub in body.get("sub-interfaces", {}).items():
            out.append(f"interface {name}.{sid}")
            e = sub.get("encapsulation", {})
            if e:
                if "dot1ad" in e:
                    s = f" encapsulation dot1ad {e['dot1ad']}"
                    if "inner-dot1q" in e:
                        s += f" inner-dot1q {e['inner-dot1q']}"
                else:
                    s = f" encapsulation dot1q {e.get('dot1q', '')}"
                    if "inner-dot1q" in e:
                        s += f" inner-dot1q {e['inner-dot1q']}"
                if e.get("exact-match"):
                    s += " exact-match"
                out.append(s)
            l3(sub)
            out.append("!")
    for name, body in cfg.get("loopbacks", {}).items():
        out.append(f"interface {name}")
        l3(body)
        out.append("!")
    return out


def vrp_name(name):
    """VPP name -> Huawei VRP alias: BondEthernetN -> Eth-TrunkN, loopN -> LoopBackN."""
    m = re.match(r"^BondEthernet(\d+)(\..*)?$", name)
    if m:
        return f"Eth-Trunk{m.group(1)}{m.group(2) or ''}"
    m = re.match(r"^loop(\d+)$", name)
    return f"LoopBack{m.group(1)}" if m else name


VRP_MODE = {"lacp": "lacp-static", "xor": "manual load-balance", "active-backup": "active-backup",
            "round-robin": "round-robin", "broadcast": "broadcast"}
VRP_LB = {"l2": "src-dst-mac", "l23": "src-dst-ip", "l34": "src-dst-ip-port"}


def vrp_lines(cfg, only=None):
    """Render the configuration Huawei VRP style; only = VPP name of one interface."""
    out = []
    bonds = cfg.get("bondethernets", {})
    ifs = cfg.get("interfaces", {})
    member_of = {m: name for name, b in bonds.items() for m in b.get("interfaces", [])}

    def l3(body, indent=" "):
        if "mac" in body:
            out.append(f"{indent}mac-address {body['mac']}")
        if "mtu" in body:
            out.append(f"{indent}mtu {body['mtu']}")
        v4 = [a for a in body.get("addresses", []) if ":" not in a]
        v6 = [a for a in body.get("addresses", []) if ":" in a]
        for i, a in enumerate(v4):
            ip, plen = a.split("/")
            mask = ipaddress.IPv4Network(f"0.0.0.0/{plen}").netmask
            out.append(f"{indent}ip address {ip} {mask}" + (" sub" if i else ""))
        if "unnumbered" in body:
            out.append(f"{indent}ip address unnumbered interface {vrp_name(body['unnumbered'])}")
        if v6:
            out.append(f"{indent}ipv6 enable")
            for a in v6:
                out.append(f"{indent}ipv6 address {a}")
        if "lcp" in body:
            out.append(f"{indent}lcp {body['lcp']}")
        if "l2xc" in body:
            out.append(f"{indent}l2xc {vrp_name(body['l2xc'])}")
        if body.get("mpls"):
            out.append(f"{indent}mpls")
        if body.get("sflow"):
            out.append(f"{indent}sflow enable")
        if body.get("state") == "down":
            out.append(f"{indent}shutdown")

    for name in sorted(set(bonds) | set(ifs), key=natural_key):
        body = ifs.get(name, {})
        if only in (None, name):
            out += ["#", f"interface {vrp_name(name)}"]
            b = bonds.get(name)
            desc = body.get("description") or (b or {}).get("description")
            if desc:
                out.append(f" description {desc}")
            if b is not None:
                if "mode" in b:
                    out.append(f" mode {VRP_MODE[b['mode']]}")
                if "load-balance" in b:
                    out.append(f" load-balance {VRP_LB[b['load-balance']]}")
            if name in member_of:
                out.append(f" eth-trunk {member_of[name][len('BondEthernet'):]}")
            l3({k: v for k, v in body.items() if k != "description"})
        for sid, sub in body.get("sub-interfaces", {}).items():
            sname = f"{name}.{sid}"
            if only not in (None, sname):
                continue
            out += ["#", f"interface {vrp_name(sname)}"]
            if "description" in sub:
                out.append(f" description {sub['description']}")
            e = sub.get("encapsulation", {})
            outer = e.get("dot1q", e.get("dot1ad"))
            if e and "inner-dot1q" in e:
                out.append(f" qinq termination pe-vid {outer} ce-vid {e['inner-dot1q']}"
                           + (" dot1ad" if "dot1ad" in e else ""))
            elif e:
                if e.get("exact-match"):
                    out.append(f" {'dot1ad' if 'dot1ad' in e else 'dot1q'} termination vid {outer}")
                else:
                    out.append(f" vlan-type {'dot1ad' if 'dot1ad' in e else 'dot1q'} {outer}")
            l3({k: v for k, v in sub.items() if k != "description"})
    for name, body in cfg.get("loopbacks", {}).items():
        if only not in (None, name):
            continue
        out += ["#", f"interface {vrp_name(name)}"]
        if "description" in body:
            out.append(f" description {body['description']}")
        l3({k: v for k, v in body.items() if k != "description"})
    if only is None:
        out += ["#", "return"]
    elif out:
        out += ["#", "return"]
    return out


def render_lines(cfg, style, only=None):
    if style == "vrp":
        return vrp_lines(cfg, only)
    lines = cisco_lines(cfg)
    if only is None:
        return lines
    # Cisco: keep the block of one interface
    out, keep = [], False
    for line in lines:
        if line.startswith("interface "):
            keep = line == f"interface {only}"
        if keep:
            out.append(line)
    return out


def cmd_show_config(xml_path, style="cisco", only=None):
    lines = render_lines(xml_to_cfg(xml_path), style, only)
    empty = "# (no interface configuration)" if style == "vrp" else "! (no interface configuration)"
    print("\n".join(lines) if lines else empty)


def cmd_diff(a_path, b_path, style="cisco"):
    a = render_lines(xml_to_cfg(a_path), style)
    b = render_lines(xml_to_cfg(b_path), style)
    diff = list(difflib.unified_diff(a, b, "running", "candidate", lineterm="", n=2))
    none = "Info: No uncommitted configuration." if style == "vrp" else "% No uncommitted changes."
    print("\n".join(diff[2:]) if diff else none)


def cmd_changed(a_path, b_path):
    """Exit 1 if configurations a and b differ, 0 if identical."""
    sys.exit(1 if xml_to_cfg(a_path) != xml_to_cfg(b_path) else 0)


def vrp_rename_output(text):
    """Rewrite VPP names in vppctl output to VRP aliases, padding to keep columns aligned."""
    def sub(m):
        new = vrp_name(m.group(0))
        pad = len(m.group(0)) - len(new)
        follow = m.string[m.end():m.end() + 1]
        return new + (" " * pad if pad > 0 and follow == " " else "")
    return re.sub(r"\b(?:BondEthernet\d+(?:\.\d+)?|loop\d+)\b", sub, text)


def cmd_vppctl(args, style="cisco"):
    r = subprocess.run([VPPCTL, *args], capture_output=True, text=True)
    out = r.stdout + r.stderr
    sys.stdout.write(vrp_rename_output(out) if style == "vrp" else out)
    sys.exit(r.returncode)


def cmd_ip_brief(style="cisco"):
    r = subprocess.run([VPPCTL, "show", "interface", "address"], capture_output=True, text=True)
    if r.returncode != 0:
        die("vppctl failed: " + (r.stderr or r.stdout))
    rows, cur = [], None
    for line in r.stdout.splitlines():
        m = re.match(r"^(\S+) \((\w+)\):", line)
        if m:
            cur = [m.group(1), "up" if m.group(2) == "up" else "down", []]
            rows.append(cur)
        elif cur and line.strip().startswith("L3 "):
            cur[2].append(line.strip()[3:])
    rows = [x for x in rows if x[0] != "local0" and not x[0].startswith("tap")]
    rename = vrp_name if style == "vrp" else (lambda n: n)
    if style == "vrp":
        print(f"{'Interface':<24} {'IP Address/Mask':<34} Physical")
        for name, state, addrs in sorted(rows, key=lambda x: natural_key(x[0])):
            print(f"{rename(name):<24} {addrs[0] if addrs else 'unassigned':<34} {'up' if state == 'up' else '*down'}")
            for a in addrs[1:]:
                print(f"{'':<24} {a}")
        return
    print(f"{'Interface':<24} {'Admin':<6} Address")
    for name, state, addrs in sorted(rows, key=lambda x: natural_key(x[0])):
        print(f"{name:<24} {state:<6} {addrs[0] if addrs else 'unassigned'}")
        for a in addrs[1:]:
            print(f"{'':<24} {'':<6} {a}")


def pop_opt(args, name, default=None):
    """Remove "--name value" from args and return value."""
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            value = args[i + 1]
            del args[i:i + 2]
            return value
    return default


def main():
    if len(sys.argv) < 2:
        die(__doc__, 2)
    verb, args = sys.argv[1], sys.argv[2:]
    style = pop_opt(args, "--style", "cisco")
    only = pop_opt(args, "--if")
    if verb == "validate" and len(args) == 1:
        cmd_validate(args[0])
    elif verb == "apply" and len(args) == 1:
        cmd_apply(args[0])
    elif verb == "import" and len(args) == 1:
        cfg = yaml.safe_load(open(args[0])) or {}
        unsupported = set(cfg) - {"interfaces", "loopbacks", "bondethernets"}
        if unsupported:
            die("vppcfg.yaml sections not yet supported by the phase 1 YANG model: " + ", ".join(sorted(unsupported)))
        sys.stdout.write(cfg_to_xml(cfg))
    elif verb == "render" and len(args) == 1:
        sys.stdout.write(render_yaml(xml_to_cfg(args[0])))
    elif verb == "show-config" and len(args) == 1:
        cmd_show_config(args[0], style, only)
    elif verb == "diff" and len(args) == 2:
        cmd_diff(*args, style=style)
    elif verb == "changed" and len(args) == 2:
        cmd_changed(*args)
    elif verb == "vppctl" and args:
        cmd_vppctl(args, style)
    elif verb == "ip-brief" and not args:
        cmd_ip_brief(style)
    else:
        die(__doc__, 2)


if __name__ == "__main__":
    main()
