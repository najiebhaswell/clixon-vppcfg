# SPDX-License-Identifier: Apache-2.0
# Huawei VRP style: ping, tracert, mtr and DNS lookups, in every view like on VRP.
# Run through nettool (sudo, group clicon): the dataplane namespace by default, -vpn-instance mgmt for
# the management network. Ctrl-C stops a running command.
CLICON_MODE="user:system:vrp-if:vrp-subif:vrp-loop:vrp-trunk:vrp-bgp:vrp-bgp-af:vrp-rpolicy";
CLICON_PLUGIN="cli_vppcfg";

ping("Send ICMP echo requests through the router's routing table (or -vpn-instance mgmt)") [<v6:string keyword:ipv6>("IPv6 destination")] [-a("Source address") <src:string regexp:"[0-9a-fA-F:.]+">("Source IPv4 or IPv6 address (one of this router's addresses)")] [-c("Number of echo requests (default 5)") <count:uint32 range[1:1000]>("Count")] [<df:string keyword:-f>("Set the don't-fragment bit (path MTU test)")] [-s("ICMP payload size (default 56 bytes)") <size:uint32 range[0:65000]>("Bytes, without the IP and ICMP headers")] [-vpn-instance("Network to use") (<vpn:string keyword:mgmt>("Management network (the host's own interfaces, e.g. eno1)")|<vpn:string keyword:dataplane>("The router's routing table through VPP (default)"))] <host:string>("Destination address or host name (resolved through the management network)"), vc_run("/usr/bin/sudo", "-n", "/usr/local/libexec/clixon-vppcfg/nettool", "--ns=$vpn", "+v6:-6", "--source=$src", "--count=$count", "+df:--df", "--size=$size", "--", "ping", "$host");
tracert("Trace the route to a destination through the router's routing table (or -vpn-instance mgmt)") [<v6:string keyword:ipv6>("IPv6 destination")] [-a("Source address") <src:string regexp:"[0-9a-fA-F:.]+">("Source IPv4 or IPv6 address (one of this router's addresses)")] [-vpn-instance("Network to use") (<vpn:string keyword:mgmt>("Management network (the host's own interfaces, e.g. eno1)")|<vpn:string keyword:dataplane>("The router's routing table through VPP (default)"))] <host:string>("Destination address or host name (resolved through the management network)"), vc_run("/usr/bin/sudo", "-n", "/usr/local/libexec/clixon-vppcfg/nettool", "--ns=$vpn", "+v6:-6", "--source=$src", "--", "traceroute", "$host");
mtr("Trace the route and measure loss and latency per hop (report after -c rounds)") [<v6:string keyword:ipv6>("IPv6 destination")] [-a("Source address") <src:string regexp:"[0-9a-fA-F:.]+">("Source IPv4 or IPv6 address (one of this router's addresses)")] [-c("Rounds (default 10, one per second)") <count:uint32 range[1:1000]>("Count")] [-vpn-instance("Network to use") (<vpn:string keyword:mgmt>("Management network (the host's own interfaces, e.g. eno1)")|<vpn:string keyword:dataplane>("The router's routing table through VPP (default)"))] <host:string>("Destination address or host name (resolved through the management network)"), vc_run("/usr/bin/sudo", "-n", "/usr/local/libexec/clixon-vppcfg/nettool", "--ns=$vpn", "+v6:-6", "--source=$src", "--count=$count", "--", "mtr", "$host");
nslookup("Look up a name or address in DNS (through the management network)") <host:string>("Host name or address") [<server:string regexp:"[0-9a-fA-F:.]+">("DNS server address (default: the resolvers in /etc/resolv.conf)")], vc_run("/usr/bin/sudo", "-n", "/usr/local/libexec/clixon-vppcfg/nettool", "--server=$server", "--", "nslookup", "$host");
dig("Query DNS (through the management network)") <host:string>("Host name, or an address for a reverse lookup") [<type:string choice:A|AAAA|ANY|CAA|CNAME|DS|DNSKEY|MX|NS|PTR|SOA|SRV|TXT>("Record type (default A; an address is looked up as PTR)")] [server("Ask this DNS server") <server:string regexp:"[0-9a-fA-F:.]+">("DNS server address (default: the resolvers in /etc/resolv.conf)")], vc_run("/usr/bin/sudo", "-n", "/usr/local/libexec/clixon-vppcfg/nettool", "--type=$type", "--server=$server", "--", "dig", "$host");
