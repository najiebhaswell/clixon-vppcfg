# SPDX-License-Identifier: Apache-2.0
# Huawei VRP style: display commands, available in all views.
CLICON_MODE="user:system:vrp-if:vrp-subif:vrp-loop:vrp-trunk:vrp-bgp:vrp-bgp-af:vrp-rpolicy";
CLICON_PLUGIN="cli_vppcfg";

display("Display information") {
    current-configuration("Committed (active) configuration"), vc_show_config("running", "vrp");
    configuration("Candidate configuration and uncommitted changes") candidate("Candidate configuration, including uncommitted changes"), vc_show_config("candidate", "vrp"); {
        changes("Uncommitted changes: candidate compared to running"), vc_show_diff("vrp");
    }
    interface("Interface state, MTU and counters (all interfaces, or one)") [(<ifname:string vc_expand_ifs("all", "vrp")>("Interface name")|<ifname:string>("Interface name"))], vc_run("/usr/local/libexec/clixon-vppcfg/clixon-vppcfg", "vppctl", "--style", "vrp", "show", "interface", "@ifname");
    interface("Interface state, MTU and counters (all interfaces, or one)") brief("Summary of all interfaces: state and IP addresses"), vc_ip_brief("vrp");
    ip("IPv4 information") {
        interface("Interface information") brief("Interfaces with IP addresses and state"), vc_ip_brief("vrp");
        routing-table("IPv4 forwarding table (VPP FIB)") {
            statistics("Number of IPv4 prefixes per prefix length"), vc_run("/usr/local/libexec/clixon-vppcfg/clixon-vppcfg", "vppctl", "--style", "vrp", "show", "ip", "fib", "summary");
            <prefix:string>("Address or prefix: show the FIB entry used to forward it"), vc_run("/usr/local/libexec/clixon-vppcfg/clixon-vppcfg", "vppctl", "--style", "vrp", "show", "ip", "fib", "$prefix");
        }
    }
    ipv6("IPv6 information") routing-table("IPv6 forwarding table (VPP FIB)") {
        statistics("Number of IPv6 prefixes per prefix length"), vc_run("/usr/local/libexec/clixon-vppcfg/clixon-vppcfg", "vppctl", "--style", "vrp", "show", "ip6", "fib", "summary");
        <prefix:string>("Address or prefix: show the FIB entry used to forward it"), vc_run("/usr/local/libexec/clixon-vppcfg/clixon-vppcfg", "vppctl", "--style", "vrp", "show", "ip6", "fib", "$prefix");
    }
    eth-trunk("Eth-Trunk members and LACP state"), vc_run("/usr/local/libexec/clixon-vppcfg/clixon-vppcfg", "vppctl", "--style", "vrp", "show", "bond", "details");
    lcp("linux-cp pairs: VPP interface and its Linux TAP in the dataplane netns"), vc_run("/usr/local/libexec/clixon-vppcfg/clixon-vppcfg", "vppctl", "--style", "vrp", "show", "lcp");
    bgp("BGP information (BIRD)") {
        all("All address families") summary("BGP peers per address family: AS, uptime, state and prefixes received, accepted and sent"), vc_run("/usr/local/libexec/clixon-vppcfg/clixon-vppcfg", "bgp-summary", "--style", "vrp");
        peer("BGP peers: all BIRD protocols with state and uptime"), vc_run("/usr/sbin/birdc", "show", "protocols"); {
            (<peer:string vc_expand_names("/bgp:routing/bgp:bgp/bgp:neighbor", "address", "Peer")>("Peer address")|<peer:string>("Peer address or BIRD protocol name")) verbose("Full details of one session"), vc_run("/usr/local/libexec/clixon-vppcfg/clixon-vppcfg", "bgp-neighbor", "$peer");
        }
        routing-table("BGP routes in BIRD") <prefix:string>("Address or prefix: best and alternative routes with attributes"), vc_run("/usr/sbin/birdc", "show", "route", "for", "$prefix", "all");
    }
    version("VPP version and build"), vc_run("/usr/local/libexec/clixon-vppcfg/clixon-vppcfg", "vppctl", "--style", "vrp", "show", "version");
}
