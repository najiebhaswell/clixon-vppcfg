# SPDX-License-Identifier: Apache-2.0
# Huawei VRP style: sub-interface view.
CLICON_MODE="vrp-subif";
CLICON_PROMPT="[~%H-subif]";
CLICON_PLUGIN="cli_vppcfg";

dot1q("802.1Q encapsulation") termination("Terminate tagged frames for routing (exact tag match)") vid("VLAN ID") <outer:uint16 range[1:4094]>("VLAN ID, 1-4094"), vc_encap("dot1q", "exact");
qinq("QinQ encapsulation") termination("Terminate double-tagged frames for routing (exact tag match)") pe-vid("Outer (provider) VLAN") <outer:uint16 range[1:4094]>("Outer VLAN ID") ce-vid("Inner (customer) VLAN") <inner:uint16 range[1:4094]>("Inner VLAN ID"), vc_encap("dot1q", "exact");
vlan-type("VLAN of the sub-interface") dot1q("802.1Q") <outer:uint16 range[1:4094]>("VLAN ID, 1-4094"), vc_encap("dot1q", "exact"); {
    non-exact("Also match frames with more tags (VPP: dot1q without exact-match; not allowed with lcp)"), vc_encap("dot1q");
}
encapsulation("Accepted for compatibility; the type follows from vlan-type or qinq termination") (dot1q-termination("Dot1q termination")|qinq-termination("QinQ termination")) [(local-switch("Accepted for compatibility")|rt-protocol("Accepted for compatibility"))], vc_noop();
control-vid("Accepted for compatibility; the VLAN follows from vlan-type or qinq termination") <cvid:uint16 range[1:4094]>("Control VLAN ID") [(dot1q-termination("Dot1q termination")|qinq-termination("QinQ termination")) [(local-switch("Accepted for compatibility")|rt-protocol("Accepted for compatibility"))]], vc_noop();
arp("ARP") broadcast("Broadcast") enable("Accepted for compatibility; ARP on sub-interfaces always works through Linux"), vc_noop();
shutdown("Administratively disable the sub-interface"), vc_set_leaf("state", "=down");
l2xc("Cross-connect all frames to another interface at layer 2 (VPP feature)") (<ifname:string vc_expand_ifs("all", "vrp")>("Target interface")|<ifname:string>("Target interface")), vc_set_leaf("l2xc", "ifname");
undo("Undo a command") {
    dot1q("Remove the encapsulation (reverts to VLAN = sub-interface number)") termination("Termination") vid("VLAN ID"), vc_del_leaf("encapsulation");
    qinq("Remove the QinQ encapsulation") termination("Termination"), vc_del_leaf("encapsulation");
    vlan-type("Remove the VLAN (reverts to VLAN = sub-interface number)"), vc_del_leaf("encapsulation"); {
        dot1q("802.1Q") <outer:uint16 range[1:4094]>("VLAN ID"), vc_del_leaf("encapsulation");
    }
    encapsulation("Accepted for compatibility"), vc_noop();
    control-vid("Accepted for compatibility"), vc_noop(); {
        <cvid:uint16 range[1:4094]>("Control VLAN ID"), vc_noop();
    }
    arp("ARP") broadcast("Broadcast") enable("Accepted for compatibility"), vc_noop();
    shutdown("Administratively enable the sub-interface"), vc_del_leaf("state");
    l2xc("Remove the layer 2 cross-connect"), vc_del_leaf("l2xc");
}
