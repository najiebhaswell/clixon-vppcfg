# Huawei VRP style: system view (prompt "[~BR]", '*' when there are uncommitted changes).
CLICON_MODE="system";
CLICON_PROMPT="[~%H]";
CLICON_PLUGIN="cli_vppcfg";

sysname("Device name: the Linux hostname, shown in the prompt") <name:string regexp:"[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?">("Letters, digits and hyphens, up to 63 characters"), vc_sys_edit("<system><hostname>$name</hostname></system>");
undo("Undo a command") sysname("Stop managing the device name (the Linux hostname stays as it is)"), vc_sys_edit("<system><hostname nc:operation='remove'/></system>");
quit("Return to the user view (refused while there are uncommitted changes)"), vc_end("user");
