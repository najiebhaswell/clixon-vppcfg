# SPDX-License-Identifier: Apache-2.0
# Huawei VRP style: BGP view (prompt "[~BR-bgp]").
CLICON_MODE="vrp-bgp";
CLICON_PROMPT="[~%H-bgp]";
CLICON_PLUGIN="cli_vppcfg";

router-id("Router ID used by BIRD (also the BGP identifier)") <rid:ipv4addr>("X.X.X.X"), vc_edit("<routing><router-id>$rid</router-id></routing>");
group("Create a peer group") (<peer:string vc_expand_names("/bgp:routing/bgp:bgp/bgp:peer-group", "name", "Existing peer group")>("Existing peer group")|<peer:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("New group name")) [(external("EBGP group (informational)")|internal("IBGP group (informational)"))], vc_edit("<routing><bgp><peer-group><name>$peer</name></peer-group></bgp></routing>");
peer("Configure a BGP peer or peer group") (<peer:string vc_expand_names("/bgp:routing/bgp:bgp/bgp:neighbor", "address", "Peer", "/bgp:routing/bgp:bgp/bgp:peer-group", "name", "Peer group")>("Peer address or group name")|<peer:string>("Peer address or group name")) {
    as-number("AS number of the peer (equal to the local AS: IBGP)") <asn:uint32 range[1:4294967295]>("AS number"), vc_edit("<routing><bgp><PEER><remote-as>$asn</remote-as></PEER></bgp></routing>");
    group("Add the peer to a peer group") (<group:string vc_expand_names("/bgp:routing/bgp:bgp/bgp:peer-group", "name", "Peer group")>("Group")|<group:string>("Group name")), vc_edit("<routing><bgp><neighbor><address>$peer</address><peer-group>$group</peer-group></neighbor></bgp></routing>");
    name("Name of the session in BIRD (birdc show protocols; default cx_<address>); renaming restarts the session") <pname:string regexp:"[A-Za-z][A-Za-z0-9_]{0,31}">("Name: letter first, then letters, digits or _ (up to 32)"), vc_edit("<routing><bgp><neighbor><address>$peer</address><name>$pname</name></neighbor></bgp></routing>");
    description("Peer description") <text:rest>("Up to 80 characters, no double quotes"), vc_edit("<routing><bgp><PEER><description>$text</description></PEER></bgp></routing>");
    connect-interface("Local source address of the session") <src:string regexp:"[0-9a-fA-F:.]+">("Local IPv4 or IPv6 address"), vc_edit("<routing><bgp><PEER><source-address>$src</source-address></PEER></bgp></routing>");
    password("TCP MD5 authentication") (cipher("Stored as entered (no encryption is applied)")|simple("Plain text")) <pw:string regexp:"[!#-~]{1,80}">("Password: printable characters, no spaces or double quotes"), vc_edit("<routing><bgp><PEER><password>$pw</password></PEER></bgp></routing>");
    ebgp-max-hop("Allow an EBGP peer that is not directly connected (default 255 hops)"), vc_edit("<routing><bgp><PEER><multihop>255</multihop></PEER></bgp></routing>"); {
        <hops:uint8 range[1:255]>("Maximum hop count"), vc_edit("<routing><bgp><PEER><multihop>$hops</multihop></PEER></bgp></routing>");
    }
    bfd("BFD") enable("Use BFD to detect a dead peer quickly"), vc_edit("<routing><bgp><PEER><bfd>true</bfd></PEER></bgp></routing>");
    timer("BGP timers") keepalive("Keepalive interval") <ka:uint16 range[1:65535]>("Seconds") hold("Hold time") <hold:uint16 range[3:65535]>("Seconds"), vc_edit("<routing><bgp><PEER><keepalive>$ka</keepalive><hold-time>$hold</hold-time></PEER></bgp></routing>");
    ignore("Administratively disable the session"), vc_edit("<routing><bgp><PEER><shutdown>true</shutdown></PEER></bgp></routing>");
}
ipv4-family("Enter the IPv4 address family view") unicast("Unicast"), vc_enter("vrp-bgp-af", "-", "af=ipv4");
ipv6-family("Enter the IPv6 address family view") unicast("Unicast"), vc_enter("vrp-bgp-af", "-", "af=ipv6");
undo("Undo a command") {
    router-id("Remove the router ID"), vc_edit("<routing><router-id nc:operation='remove'/></routing>");
    group("Delete a peer group") (<group:string vc_expand_names("/bgp:routing/bgp:bgp/bgp:peer-group", "name", "Peer group")>("Group")|<group:string>("Group name")), vc_edit("<routing><bgp><peer-group nc:operation='remove'><name>$group</name></peer-group></bgp></routing>");
    peer("Delete a peer, or undo one of its settings") (<peer:string vc_expand_names("/bgp:routing/bgp:bgp/bgp:neighbor", "address", "Peer", "/bgp:routing/bgp:bgp/bgp:peer-group", "name", "Peer group")>("Peer address or group name")|<peer:string>("Peer address or group name")), vc_edit("<routing><bgp><PEER nc:operation='remove'></PEER></bgp></routing>"); {
        as-number("Remove the AS number"), vc_edit("<routing><bgp><PEER><remote-as nc:operation='remove'/></PEER></bgp></routing>");
        group("Remove the peer from its group") (<group:string vc_expand_names("/bgp:routing/bgp:bgp/bgp:peer-group", "name", "Peer group")>("Group")|<group:string>("Group name")), vc_edit("<routing><bgp><neighbor><address>$peer</address><peer-group nc:operation='remove'/></neighbor></bgp></routing>");
        name("Revert to the default session name cx_<address> (restarts the session)"), vc_edit("<routing><bgp><neighbor><address>$peer</address><name nc:operation='remove'/></neighbor></bgp></routing>");
        description("Remove the description"), vc_edit("<routing><bgp><PEER><description nc:operation='remove'/></PEER></bgp></routing>");
        connect-interface("Remove the source address"), vc_edit("<routing><bgp><PEER><source-address nc:operation='remove'/></PEER></bgp></routing>");
        password("Remove the password"), vc_edit("<routing><bgp><PEER><password nc:operation='remove'/></PEER></bgp></routing>");
        ebgp-max-hop("Only allow directly connected EBGP peers"), vc_edit("<routing><bgp><PEER><multihop nc:operation='remove'/></PEER></bgp></routing>");
        bfd("BFD") enable("Stop using BFD"), vc_edit("<routing><bgp><PEER><bfd nc:operation='remove'/></PEER></bgp></routing>");
        timer("Revert to the default timers"), vc_edit("<routing><bgp><PEER><keepalive nc:operation='remove'/><hold-time nc:operation='remove'/></PEER></bgp></routing>");
        ignore("Enable the session"), vc_edit("<routing><bgp><PEER><shutdown nc:operation='remove'/></PEER></bgp></routing>");
    }
}
quit("Return to the system view"), vc_if_exit("system");
