# SPDX-License-Identifier: Apache-2.0
# Huawei VRP style: BGP, ip-prefix, community-filter and route-policy in the system view.
CLICON_MODE="system";
CLICON_PLUGIN="cli_vppcfg";

bgp("Enter the BGP view (BIRD)") <asn:uint32 range[1:4294967295]>("Local AS number"), vc_enter("vrp-bgp", "<routing><bgp><local-as>$asn</local-as></bgp></routing>");
router("Router") id("Router ID used by BIRD (also the BGP identifier)") <rid:ipv4addr>("X.X.X.X"), vc_edit("<routing><router-id>$rid</router-id></routing>");
ip("IP") {
    ip-prefix("IPv4 prefix list (lowest index first, implicit deny at the end)") <name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("Prefix list name") index("Entry index") <seq:uint32 range[1:4294967295]>("Index; lower is evaluated first") (<action:string keyword:permit>("Permit matching routes")|<action:string keyword:deny>("Deny matching routes")) <ip:ipv4addr>("IPv4 address") <len:uint8 range[0:32]>("Mask length") [greater-equal("Minimum mask length") <ge:uint8 range[1:32]>("Minimum length")] [less-equal("Maximum mask length") <le:uint8 range[1:32]>("Maximum length")], vc_edit("<routing><prefix-list><name>$name</name><entry nc:operation='replace'><seq>$seq</seq><action>$action</action><prefix>$ip/$len</prefix>[<ge>$ge</ge>][<le>$le</le>]</entry></prefix-list></routing>");
    ipv6-prefix("IPv6 prefix list (lowest index first, implicit deny at the end)") <name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("Prefix list name") index("Entry index") <seq:uint32 range[1:4294967295]>("Index; lower is evaluated first") (<action:string keyword:permit>("Permit matching routes")|<action:string keyword:deny>("Deny matching routes")) <ip6:ipv6addr>("IPv6 address") <len6:uint8 range[0:128]>("Prefix length") [greater-equal("Minimum prefix length") <ge:uint8 range[1:128]>("Minimum length")] [less-equal("Maximum prefix length") <le:uint8 range[1:128]>("Maximum length")], vc_edit("<routing><prefix-list><name>$name</name><entry nc:operation='replace'><seq>$seq</seq><action>$action</action><prefix>$ip6/$len6</prefix>[<ge>$ge</ge>][<le>$le</le>]</entry></prefix-list></routing>");
    community-filter("Community filter") basic("Basic community filter") <name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("Filter name") permit("Add a community") <comm:string regexp:"[0-9]{1,5}:[0-9]{1,5}">("Community AA:NN, e.g. 65000:100"), vc_edit("<routing><community-list><name>$name</name><community>$comm</community></community-list></routing>");
}
route-policy("Route policy: policy for routes received from or announced to BGP peers") <name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("Route policy name") (<action:string keyword:permit>("Permit matching routes")|<action:string keyword:deny>("Deny matching routes")) node("Policy node") <seq:uint32 range[1:4294967295]>("Node number; lower is evaluated first"), vc_enter("vrp-rpolicy", "<routing><route-policy><name>$name</name><node><seq>$seq</seq><action>$action</action></node></route-policy></routing>", "rp=$name", "rseq=$seq");
undo("Undo a command") {
    bgp("Remove the whole BGP configuration (all peers, networks)") [<asn:uint32 range[1:4294967295]>("Local AS number")], vc_edit("<routing><bgp nc:operation='remove'/></routing>");
    router("Router") id("Remove the router ID (BIRD then picks one from the interfaces)"), vc_edit("<routing><router-id nc:operation='remove'/></routing>");
    ip("IP") {
        ip-prefix("Remove a prefix list or one entry") (<pl:string vc_expand_names("/bgp:routing/bgp:prefix-list", "name", "IP prefix list")>("IP prefix list")|<pl:string>("IP prefix list name")), vc_edit("<routing><prefix-list nc:operation='remove'><name>$pl</name></prefix-list></routing>"); {
            index("Remove one entry") <seq:uint32 range[1:4294967295]>("Index"), vc_edit("<routing><prefix-list><name>$pl</name><entry nc:operation='remove'><seq>$seq</seq></entry></prefix-list></routing>");
        }
        ipv6-prefix("Remove a prefix list or one entry") (<pl:string vc_expand_names("/bgp:routing/bgp:prefix-list", "name", "IP prefix list")>("IP prefix list")|<pl:string>("IP prefix list name")), vc_edit("<routing><prefix-list nc:operation='remove'><name>$pl</name></prefix-list></routing>"); {
            index("Remove one entry") <seq:uint32 range[1:4294967295]>("Index"), vc_edit("<routing><prefix-list><name>$pl</name><entry nc:operation='remove'><seq>$seq</seq></entry></prefix-list></routing>");
        }
        community-filter("Community filter") basic("Remove a community filter or one community") (<cl:string vc_expand_names("/bgp:routing/bgp:community-list", "name", "Community filter")>("Community filter")|<cl:string>("Community filter name")), vc_edit("<routing><community-list nc:operation='remove'><name>$cl</name></community-list></routing>"); {
            permit("Remove one community") <comm:string regexp:"[0-9]{1,5}:[0-9]{1,5}">("Community AA:NN, e.g. 65000:100"), vc_edit("<routing><community-list><name>$cl</name><community nc:operation='remove'>$comm</community></community-list></routing>");
        }
    }
    route-policy("Remove a route policy or one node") (<rm:string vc_expand_names("/bgp:routing/bgp:route-policy", "name", "Route policy")>("Route policy")|<rm:string>("Route policy name")), vc_edit("<routing><route-policy nc:operation='remove'><name>$rm</name></route-policy></routing>"); {
        node("Remove one node") <seq:uint32 range[1:4294967295]>("Node number"), vc_edit("<routing><route-policy><name>$rm</name><node nc:operation='remove'><seq>$seq</seq></node></route-policy></routing>");
    }
}
