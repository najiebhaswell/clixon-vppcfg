# SPDX-License-Identifier: Apache-2.0
# Huawei VRP style: BGP, ip-prefix, as-path-filter, (large-)community-filter and route-policy in the system view.
CLICON_MODE="system";
CLICON_PLUGIN="cli_vppcfg";

bgp("Enter the BGP view (BIRD)") (<asn:string vc_expand_names("/bgp:routing/bgp:bgp", "local-as", "Configured local AS")>("Local AS number")|<asn:uint32 range[1:4294967295]>("Local AS number")), vc_enter("vrp-bgp", "<routing><bgp><local-as>$asn</local-as></bgp></routing>");
router("Router") id("Router ID used by BIRD (also the BGP identifier)") <rid:ipv4addr>("X.X.X.X"), vc_edit("<routing><router-id>$rid</router-id></routing>");
ip("IP") {
    ip-prefix("IPv4 prefix list (lowest index first, implicit deny at the end)") (<name:string vc_expand_names("/bgp:routing/bgp:prefix-list", "name", "Existing IP prefix list")>("Existing IP prefix list")|<name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("New prefix list name")) index("Entry index") (<seq:string vc_expand_names("/bgp:routing/bgp:prefix-list[bgp:name='$name']/bgp:entry", "seq", "Existing index (replaced)")>("Existing index (replaced)")|<seq:uint32 range[1:4294967295]>("Index; lower is evaluated first")) (<action:string keyword:permit>("Permit matching routes")|<action:string keyword:deny>("Deny matching routes")) <ip:ipv4addr>("IPv4 address") <len:uint8 range[0:32]>("Mask length") [greater-equal("Minimum mask length") <ge:uint8 range[1:32]>("Minimum length")] [less-equal("Maximum mask length") <le:uint8 range[1:32]>("Maximum length")], vc_edit("<routing><prefix-list><name>$name</name><entry nc:operation='replace'><seq>$seq</seq><action>$action</action><prefix>$ip/$len</prefix>[<ge>$ge</ge>][<le>$le</le>]</entry></prefix-list></routing>");
    ipv6-prefix("IPv6 prefix list (lowest index first, implicit deny at the end)") (<name:string vc_expand_names("/bgp:routing/bgp:prefix-list", "name", "Existing IP prefix list")>("Existing IP prefix list")|<name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("New prefix list name")) index("Entry index") (<seq:string vc_expand_names("/bgp:routing/bgp:prefix-list[bgp:name='$name']/bgp:entry", "seq", "Existing index (replaced)")>("Existing index (replaced)")|<seq:uint32 range[1:4294967295]>("Index; lower is evaluated first")) (<action:string keyword:permit>("Permit matching routes")|<action:string keyword:deny>("Deny matching routes")) <ip6:ipv6addr>("IPv6 address") <len6:uint8 range[0:128]>("Prefix length") [greater-equal("Minimum prefix length") <ge:uint8 range[1:128]>("Minimum length")] [less-equal("Maximum prefix length") <le:uint8 range[1:128]>("Maximum length")], vc_edit("<routing><prefix-list><name>$name</name><entry nc:operation='replace'><seq>$seq</seq><action>$action</action><prefix>$ip6/$len6</prefix>[<ge>$ge</ge>][<le>$le</le>]</entry></prefix-list></routing>");
    as-path-filter("AS-path filter: entries tried by index, the first match decides, no match is deny") (<name:string vc_expand_names("/bgp:routing/bgp:as-path-list", "name", "Existing AS-path filter")>("Existing AS-path filter")|<name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("New AS-path filter name")) index("Entry index") (<seq:string vc_expand_names("/bgp:routing/bgp:as-path-list[bgp:name='$name']/bgp:entry", "seq", "Existing index (replaced)")>("Existing index (replaced)")|<seq:uint32 range[1:4294967295]>("Index; lower is evaluated first")) (<action:string keyword:permit>("Permit matching routes")|<action:string keyword:deny>("Deny matching routes")) {
        <re:string regexp:"[^A-Za-z ]+">("Regular expression: ^$ own routes, _64500$ originated by AS 64500, ^64500_ received from AS 64500, _(64500|64501)_ via either AS (put the whole expression in double quotes when it has |), .* any"), vc_aspath("<routing><as-path-list><name>$name</name><entry nc:operation='replace'><seq>$seq</seq><action>$action</action><regex>$re</regex></entry></as-path-list></routing>");
        bird-mask("Use a BIRD path mask instead of a regular expression") <mask:rest>("BIRD path mask, e.g. [= * 64512..65534 * =] (type [0-9]+ in a regular expression instead of ?)"), vc_aspath("<routing><as-path-list><name>$name</name><entry nc:operation='replace'><seq>$seq</seq><action>$action</action><bird-mask>$mask</bird-mask></entry></as-path-list></routing>");
    }
    large-community-filter("Large community filter (RFC 8092)") basic("Basic large community filter") (<name:string vc_expand_names("/bgp:routing/bgp:large-community-list", "name", "Existing large community filter")>("Existing large community filter")|<name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("New filter name")) permit("Add a large community") <lc:string regexp:"[0-9]{1,10}:[0-9]{1,10}:[0-9]{1,10}">("Large community ASN:data1:data2, e.g. 65000:1:100"), vc_edit("<routing><large-community-list><name>$name</name><large-community>$lc</large-community></large-community-list></routing>");
    community-filter("Community filter") basic("Basic community filter") (<name:string vc_expand_names("/bgp:routing/bgp:community-list", "name", "Existing community filter")>("Existing community filter")|<name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("New filter name")) permit("Add a community") <comm:string regexp:"[0-9]{1,5}:[0-9]{1,5}">("Community AA:NN, e.g. 65000:100"), vc_edit("<routing><community-list><name>$name</name><community>$comm</community></community-list></routing>");
}
route-policy("Route policy: policy for routes received from or announced to BGP peers") (<name:string vc_expand_names("/bgp:routing/bgp:route-policy", "name", "Existing route policy")>("Existing route policy")|<name:string regexp:"[A-Za-z][A-Za-z0-9_-]{0,47}">("New route policy name")) (<action:string keyword:permit>("Permit matching routes")|<action:string keyword:deny>("Deny matching routes")) node("Policy node") (<seq:string vc_expand_names("/bgp:routing/bgp:route-policy[bgp:name='$name']/bgp:node", "seq", "Existing node")>("Existing node")|<seq:uint32 range[1:4294967295]>("Node number; lower is evaluated first")), vc_enter("vrp-rpolicy", "<routing><route-policy><name>$name</name><node><seq>$seq</seq><action>$action</action></node></route-policy></routing>", "rp=$name", "rseq=$seq");
undo("Undo a command") {
    bgp("Remove the whole BGP configuration (all peers, networks)") [(<asn:string vc_expand_names("/bgp:routing/bgp:bgp", "local-as", "Configured local AS")>("Local AS number")|<asn:uint32 range[1:4294967295]>("Local AS number"))], vc_edit("<routing><bgp nc:operation='remove'/></routing>");
    router("Router") id("Remove the router ID (BIRD then picks one from the interfaces)"), vc_edit("<routing><router-id nc:operation='remove'/></routing>");
    ip("IP") {
        ip-prefix("Remove a prefix list or one entry") (<pl:string vc_expand_names("/bgp:routing/bgp:prefix-list", "name", "IP prefix list")>("IP prefix list")|<pl:string>("IP prefix list name")), vc_edit("<routing><prefix-list nc:operation='remove'><name>$pl</name></prefix-list></routing>"); {
            index("Remove one entry") <seq:uint32 range[1:4294967295]>("Index"), vc_edit("<routing><prefix-list><name>$pl</name><entry nc:operation='remove'><seq>$seq</seq></entry></prefix-list></routing>");
        }
        ipv6-prefix("Remove a prefix list or one entry") (<pl:string vc_expand_names("/bgp:routing/bgp:prefix-list", "name", "IP prefix list")>("IP prefix list")|<pl:string>("IP prefix list name")), vc_edit("<routing><prefix-list nc:operation='remove'><name>$pl</name></prefix-list></routing>"); {
            index("Remove one entry") <seq:uint32 range[1:4294967295]>("Index"), vc_edit("<routing><prefix-list><name>$pl</name><entry nc:operation='remove'><seq>$seq</seq></entry></prefix-list></routing>");
        }
        as-path-filter("Remove an AS-path filter or one entry") (<apl:string vc_expand_names("/bgp:routing/bgp:as-path-list", "name", "AS-path filter")>("AS-path filter")|<apl:string>("AS-path filter name")), vc_edit("<routing><as-path-list nc:operation='remove'><name>$apl</name></as-path-list></routing>"); {
            index("Remove one entry") <seq:uint32 range[1:4294967295]>("Index"), vc_edit("<routing><as-path-list><name>$apl</name><entry nc:operation='remove'><seq>$seq</seq></entry></as-path-list></routing>");
        }
        large-community-filter("Large community filter") basic("Remove a large community filter or one large community") (<lcl:string vc_expand_names("/bgp:routing/bgp:large-community-list", "name", "Large community filter")>("Large community filter")|<lcl:string>("Large community filter name")), vc_edit("<routing><large-community-list nc:operation='remove'><name>$lcl</name></large-community-list></routing>"); {
            permit("Remove one large community") <lc:string regexp:"[0-9]{1,10}:[0-9]{1,10}:[0-9]{1,10}">("Large community ASN:data1:data2, e.g. 65000:1:100"), vc_edit("<routing><large-community-list><name>$lcl</name><large-community nc:operation='remove'>$lc</large-community></large-community-list></routing>");
        }
        community-filter("Community filter") basic("Remove a community filter or one community") (<cl:string vc_expand_names("/bgp:routing/bgp:community-list", "name", "Community filter")>("Community filter")|<cl:string>("Community filter name")), vc_edit("<routing><community-list nc:operation='remove'><name>$cl</name></community-list></routing>"); {
            permit("Remove one community") <comm:string regexp:"[0-9]{1,5}:[0-9]{1,5}">("Community AA:NN, e.g. 65000:100"), vc_edit("<routing><community-list><name>$cl</name><community nc:operation='remove'>$comm</community></community-list></routing>");
        }
    }
    route-policy("Remove a route policy or one node") (<rm:string vc_expand_names("/bgp:routing/bgp:route-policy", "name", "Route policy")>("Route policy")|<rm:string>("Route policy name")), vc_edit("<routing><route-policy nc:operation='remove'><name>$rm</name></route-policy></routing>"); {
        node("Remove one node") <seq:uint32 range[1:4294967295]>("Node number"), vc_edit("<routing><route-policy><name>$rm</name><node nc:operation='remove'><seq>$seq</seq></node></route-policy></routing>");
    }
}
